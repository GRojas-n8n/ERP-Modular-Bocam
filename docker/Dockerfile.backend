# syntax=docker/dockerfile:1.7

FROM node:20-bookworm-slim AS builder

WORKDIR /workspace

RUN apt-get update \
  && apt-get install -y --no-install-recommends openssl python3 make g++ \
  && rm -rf /var/lib/apt/lists/*

# Mismo patrón que Dockerfile.app-shell/reportes/asistente: el glob
# "COPY apps/*/package.json ./apps/" colapsaba todos los package.json en
# ./apps/package.json, rompiendo la resolución de workspaces de npm ci.
# Copiamos el repo completo (el .dockerignore excluye node_modules y dist).
COPY . .

# npm_config_production=false: instala devDependencies (typescript, prisma)
# aunque el build reciba NODE_ENV=production.
RUN npm_config_production=false npm ci

ARG WORKSPACE_NAME
ARG APP_PATH

RUN if [ -f "${APP_PATH}/prisma/schema.prisma" ]; then \
    ./node_modules/.bin/prisma generate --schema "${APP_PATH}/prisma/schema.prisma"; \
  fi
RUN npm run build -w ${WORKSPACE_NAME}
# Copiar archivos generados de Prisma al directorio dist (TypeScript no copia JS generados)
RUN if [ -d "${APP_PATH}/src/generated/prisma" ]; then \
    mkdir -p "${APP_PATH}/dist/${APP_PATH}/src/generated"; \
    cp -r "${APP_PATH}/src/generated/prisma" "${APP_PATH}/dist/${APP_PATH}/src/generated/prisma"; \
  fi

FROM node:20-bookworm-slim AS runner

WORKDIR /workspace

ENV NODE_ENV=production

RUN apt-get update \
  && apt-get install -y --no-install-recommends openssl wget \
  && rm -rf /var/lib/apt/lists/*

COPY --from=builder /workspace/node_modules ./node_modules
COPY --from=builder /workspace/apps ./apps
COPY --from=builder /workspace/packages ./packages
COPY docker/backend-entrypoint.sh /usr/local/bin/backend-entrypoint.sh

RUN chmod +x /usr/local/bin/backend-entrypoint.sh

ARG APP_PATH
ENV APP_PATH=${APP_PATH}

CMD ["backend-entrypoint.sh"]
