# syntax=docker/dockerfile:1.7

FROM node:20-bookworm-slim AS builder

WORKDIR /workspace

RUN apt-get update \
  && apt-get install -y --no-install-recommends openssl python3 make g++ \
  && rm -rf /var/lib/apt/lists/*

COPY package*.json ./
COPY apps/*/package.json ./apps/
COPY packages/*/package.json ./packages/

RUN npm ci

COPY . .

ARG WORKSPACE_NAME
ARG APP_PATH

# Se generan los clientes Prisma de TODOS los servicios, no solo el de APP_PATH (openspec: deploy-genera-todos-los-clientes-prisma).
# El `tsc` de algunos servicios (contabilidad, almacen) compila también sus pruebas, que importan código de otros
# servicios; con el cliente versionado de esos servicios (desactualizado) el build falla. El runtime sigue copiando
# solo el cliente de APP_PATH.
RUN for schema in apps/*/prisma/schema.prisma; do \
    ./node_modules/.bin/prisma generate --schema "$schema" || exit 1; \
  done
RUN npm run build -w ${WORKSPACE_NAME}
# Copiar archivos generados de Prisma al directorio dist (TypeScript no copia JS generados)
RUN if [ -d "${APP_PATH}/src/generated/prisma" ]; then \
    mkdir -p "${APP_PATH}/dist/${APP_PATH}/src/generated"; \
    cp -r "${APP_PATH}/src/generated/prisma" "${APP_PATH}/dist/${APP_PATH}/src/generated/prisma"; \
  fi

FROM node:20-bookworm-slim AS runner

WORKDIR /workspace

ENV NODE_ENV=production

RUN apt-get update \
  && apt-get install -y --no-install-recommends openssl wget \
  && rm -rf /var/lib/apt/lists/*

COPY --from=builder /workspace/node_modules ./node_modules
COPY --from=builder /workspace/apps ./apps
COPY --from=builder /workspace/packages ./packages
COPY docker/backend-entrypoint.sh /usr/local/bin/backend-entrypoint.sh

RUN chmod +x /usr/local/bin/backend-entrypoint.sh

ARG APP_PATH
ENV APP_PATH=${APP_PATH}

CMD ["backend-entrypoint.sh"]
