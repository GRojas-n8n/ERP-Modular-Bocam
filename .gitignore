# ─────────────────────────────────────────────────────────────────────────────
# BOCAM ERP Modular — .gitignore
# ─────────────────────────────────────────────────────────────────────────────

# Dependencies
node_modules/
.pnp
.pnp.js

# Build output
dist/
build/
.next/
out/

# Environment files (NEVER commit secrets)
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
.env.*.local
.env.bak.*

# Prisma
prisma/migrations/**/migration_lock.toml
# Binarios nativos generados por Prisma client (especificos del SO)
**/generated/prisma/libquery_engine-*.so.node
**/generated/prisma/query_engine-windows.dll.node

# IDE
.vscode/
.idea/
*.swp
*.swo
*~

# OS
.DS_Store
Thumbs.db
desktop.ini

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Docker
docker-compose.override.yml

# Test coverage
coverage/
.nyc_output/

# Temp
tmp/
.tmp/

bocam_deploy_key
bocam_deploy_key.pub

# SSH keys (never commit private keys)
bocam_deploy_key
bocam_deploy_key.pub
bocam_vps_key
bocam_vps_key.pub
*_deploy_key
*_deploy_key.pub
*_vps_key
*_vps_key.pub

# Editor / AI tool local configs
.claude/
.cursor/
