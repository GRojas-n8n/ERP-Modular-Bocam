# ---------------------------------------------------------------------------
# iRetum — Entorno LOCAL (docker-compose.local.yml)
# Copiar a .env.local (scripts/local/iretum-local.ps1 lo hace solo y genera
# secretos aleatorios). Todos los valores son de DESARROLLO: ninguna
# credencial real. Todas las URLs apuntan a servicios de la red docker
# "iretum-local"; scripts/local/verificar-env-local.mjs bloquea el arranque
# si alguna apunta fuera de la máquina.
# ---------------------------------------------------------------------------

NODE_ENV=production

# Postgres: superusuario local, SOLO para migraciones, seeds y rls-policies.sql
LOCAL_DB_ADMIN_USER=bocam_admin
LOCAL_DB_ADMIN_PASSWORD=local_admin_CAMBIAR
# Rol de runtime (sin SUPERUSER ni BYPASSRLS), igual que en el VPS
LOCAL_APP_DB_PASSWORD=local_app_CAMBIAR

# Una base por servicio, mismos nombres que en el VPS; las apps entran como bocam_app
AUTH_DATABASE_URL=postgresql://bocam_app:local_app_CAMBIAR@postgres:5432/bocam_auth
GERENCIA_TECNICA_DATABASE_URL=postgresql://bocam_app:local_app_CAMBIAR@postgres:5432/bocam_gerencia_tecnica
COMPRAS_DATABASE_URL=postgresql://bocam_app:local_app_CAMBIAR@postgres:5432/bocam_compras
FINANZAS_DATABASE_URL=postgresql://bocam_app:local_app_CAMBIAR@postgres:5432/bocam_finanzas
PERSONAL_DATABASE_URL=postgresql://bocam_app:local_app_CAMBIAR@postgres:5432/bocam_personal
SEGURIDAD_DATABASE_URL=postgresql://bocam_app:local_app_CAMBIAR@postgres:5432/bocam_seguridad
VENTAS_DATABASE_URL=postgresql://bocam_app:local_app_CAMBIAR@postgres:5432/bocam_ventas
CONTABILIDAD_DATABASE_URL=postgresql://bocam_app:local_app_CAMBIAR@postgres:5432/bocam_contabilidad
CALIDAD_DATABASE_URL=postgresql://bocam_app:local_app_CAMBIAR@postgres:5432/bocam_calidad
ALMACEN_DATABASE_URL=postgresql://bocam_app:local_app_CAMBIAR@postgres:5432/bocam_almacen
CONTROL_PROYECTOS_DATABASE_URL=postgresql://bocam_app:local_app_CAMBIAR@postgres:5432/bocam_control_proyectos

# Mensajería y caché
RMQ_USER=bocam_broker
RMQ_PASSWORD=local_rmq_CAMBIAR
RABBITMQ_URL=amqp://bocam_broker:local_rmq_CAMBIAR@rabbitmq:5672
REDIS_URL=redis://redis:6379

# Secretos de desarrollo
JWT_SECRET=local_jwt_CAMBIAR
JWT_ACCESS_EXPIRATION=15m
JWT_REFRESH_EXPIRATION=7d
JWT_MAX_SESSION_HOURS=16
MASTER_SECRET=local_master_CAMBIAR
SAT_CALLBACK_SHARED_SECRET=local_sat_CAMBIAR
