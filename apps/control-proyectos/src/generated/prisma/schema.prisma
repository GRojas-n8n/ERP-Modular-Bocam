// Control de Proyectos — EVM, Curva S, Alertas Predictivas
// Puerto: 3013 | Schema: control_proyectos

generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// Programación planificada por partida (Gantt simplificado + Curva S)
model ProgramacionObra {
  id             String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenant_id      String @db.Uuid
  proyecto_id    String @db.Uuid
  concepto_id    String @db.Uuid
  concepto_clave String @db.VarChar(100)
  descripcion    String @db.Text

  fecha_inicio_plan DateTime @db.Date
  fecha_fin_plan    DateTime @db.Date

  // JSONB: [{ semana: "2026-W22", pct_acumulado: 15.0 }, ...]
  curva_programada Json @db.JsonB

  // Calculados por subscribers de eventos
  fecha_inicio_real DateTime? @db.Date
  fecha_fin_real    DateTime? @db.Date
  pct_avance_real   Decimal   @default(0) @db.Decimal(5, 2)

  // EVM por partida
  cpi Decimal? @db.Decimal(6, 4)
  spi Decimal? @db.Decimal(6, 4)
  eac Decimal? @db.Decimal(18, 2)
  bac Decimal  @default(0) @db.Decimal(18, 2)

  // AC (costo real) compuesto — openspec: fix-evm-costos-reales.
  // ac_comprometido: suma de OrdenCompraSeguimiento.monto_comprometido de las
  // OC activas ligadas a este concepto_id (subscriber compras.oc_creada).
  // ac_ejercido: suma de OrdenCompraSeguimiento.monto_ejercido, movido desde
  // comprometido cuando se paga la OC (subscriber finanzas.pago_registrado,
  // referencia_entidad = 'OrdenCompra'). ac = ac_comprometido + ac_ejercido.
  ac_comprometido Decimal @default(0) @db.Decimal(18, 2)
  ac_ejercido     Decimal @default(0) @db.Decimal(18, 2)

  // PENDIENTE | EN_CURSO | COMPLETADA | ATRASADA
  estado String @default("PENDIENTE") @db.VarChar(20)

  created_at DateTime @default(now()) @db.Timestamptz(6)
  updated_at DateTime @updatedAt @db.Timestamptz(6)

  @@unique([tenant_id, proyecto_id, concepto_id])
  @@index([tenant_id, proyecto_id], name: "idx_prog_proyecto")
  @@map("programacion_obra")
}

// Seguimiento de orden de compra → concepto (openspec: fix-evm-costos-reales).
// Poblado por el subscriber de compras.oc_creada (único momento en que el
// payload trae concepto_id) y consultado por los subscribers de
// compras.oc_cancelada / finanzas.pago_registrado (referencia_entidad =
// 'OrdenCompra'), que NO traen concepto_id en su payload — ver design.md
// Decisión 1/2.
model OrdenCompraSeguimiento {
  id          String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  oc_id       String @unique @db.Uuid
  tenant_id   String @db.Uuid
  proyecto_id String @db.Uuid
  concepto_id String @db.Uuid

  monto_comprometido Decimal @default(0) @db.Decimal(18, 2)
  monto_ejercido     Decimal @default(0) @db.Decimal(18, 2)

  created_at DateTime @default(now()) @db.Timestamptz(6)
  updated_at DateTime @updatedAt @db.Timestamptz(6)

  @@index([tenant_id, proyecto_id, concepto_id], name: "idx_oc_seguimiento_concepto")
  @@map("ordenes_compra_seguimiento")
}

// Acumulador de mano de obra pagada por proyecto (openspec:
// fix-evm-costos-reales, design.md Decisión 6 / Non-Goal de distribución por
// partida). Alimentado por el subscriber de finanzas.pago_registrado con
// referencia_entidad = 'PreNomina'; leído por el job nocturno para sumar al
// AC global de ProyeccionCierre. No existe forma de atribuir esto a un
// concepto_id individual (ver Non-Goals de design.md), por eso vive a nivel
// proyecto y no en ProgramacionObra.
model ManoObraProyecto {
  id              String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenant_id       String  @db.Uuid
  proyecto_id     String  @db.Uuid
  monto_acumulado Decimal @default(0) @db.Decimal(18, 2)

  created_at DateTime @default(now()) @db.Timestamptz(6)
  updated_at DateTime @updatedAt @db.Timestamptz(6)

  @@unique([tenant_id, proyecto_id])
  @@map("mano_obra_proyecto")
}

// Idempotencia de finanzas.pago_registrado para las ramas nuevas
// (OrdenCompra / PreNomina) — a diferencia del subscriber de
// almacen.salida_obra (dedupe por movimiento_almacen_id) o el de
// compras.oc_creada (dedupe por oc_id en OrdenCompraSeguimiento), un pago
// no tiene una entidad propia en este esquema donde apoyar el dedupe: se
// registra explícitamente por id_pago para que un redelivery de RabbitMQ no
// vuelva a mover fondos de comprometido→ejercido ni a inflar el acumulado
// de mano de obra.
model PagoEvmProcesado {
  id_pago     String  @id @db.Uuid
  tenant_id   String  @db.Uuid
  proyecto_id String  @db.Uuid
  tipo        String  @db.VarChar(20) // ORDEN_COMPRA | PRE_NOMINA
  monto       Decimal @db.Decimal(18, 2)

  created_at DateTime @default(now()) @db.Timestamptz(6)

  @@index([tenant_id, proyecto_id], name: "idx_pago_evm_proyecto")
  @@map("pagos_evm_procesados")
}

// Alertas predictivas generadas automáticamente
model AlertaProyecto {
  id          String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenant_id   String  @db.Uuid
  proyecto_id String  @db.Uuid
  concepto_id String? @db.Uuid

  // PARTIDA_BLOQUEADA | SOBRE_COSTO_PROYECTADO | RETRASO_CRITICO |
  // MATERIAL_INMOVILIZADO | BRECHA_FISICO_ECONOMICO | PROVEEDOR_SIN_PAGAR |
  // NOMINA_SIN_COSTO | IMPREVISTO_EXCESIVO | TRANSFERENCIA_PENDIENTE
  tipo        String @db.VarChar(50)
  severidad   String @db.VarChar(10) // INFO | WARN | CRITICA
  titulo      String @db.VarChar(200)
  descripcion String @db.Text
  datos       Json   @db.JsonB

  // ACTIVA | RECONOCIDA | RESUELTA | IGNORADA
  estado      String    @default("ACTIVA") @db.VarChar(20)
  nota_cp     String?   @db.Text
  resuelta_en DateTime? @db.Timestamptz(6)

  created_at DateTime @default(now()) @db.Timestamptz(6)
  updated_at DateTime @updatedAt @db.Timestamptz(6)

  @@index([tenant_id, proyecto_id, estado], name: "idx_alerta_proyecto_estado")
  @@index([tenant_id, proyecto_id, tipo], name: "idx_alerta_proyecto_tipo")
  @@map("alertas_proyecto")
}

// Snapshot periódico de EVM global por proyecto
model ProyeccionCierre {
  id            String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenant_id     String   @db.Uuid
  proyecto_id   String   @db.Uuid
  fecha_calculo DateTime @db.Date

  // EVM global
  bac Decimal @db.Decimal(18, 2)
  pv  Decimal @db.Decimal(18, 2)
  ev  Decimal @db.Decimal(18, 2)
  ac  Decimal @db.Decimal(18, 2)

  cpi Decimal @db.Decimal(6, 4)
  spi Decimal @db.Decimal(6, 4)
  cv  Decimal @db.Decimal(18, 2)
  sv  Decimal @db.Decimal(18, 2)

  eac Decimal @db.Decimal(18, 2)
  etc Decimal @db.Decimal(18, 2)
  vac Decimal @db.Decimal(18, 2)

  fecha_fin_plan       DateTime? @db.Date
  fecha_fin_proyectada DateTime? @db.Date

  created_at DateTime @default(now()) @db.Timestamptz(6)

  @@index([tenant_id, proyecto_id, fecha_calculo], name: "idx_proyeccion_fecha")
  @@map("proyecciones_cierre")
}

// ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
// Migrado de control-obra (fusionar-control-obra-a-control-proyectos)
// ENTIDAD: Bitácora de Obra
// Registro diario obligatorio en sitio. Cada entrada pertenece a un frente
// de trabajo y es firmada por el residente responsable.
// ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━

model BitacoraObra {
  id_bitacora    String   @id @default(uuid()) @db.Uuid
  tenant_id      String   @db.Uuid
  proyecto_id    String   @db.Uuid
  numero_entrada Int // Consecutivo por proyecto
  fecha          DateTime @db.Date // Día de la anotación
  frente_trabajo String   @db.VarChar(100) // Ej: "Frente 1 - Cimentación"
  turno          String   @default("DIURNO") // DIURNO, NOCTURNO, MIXTO
  clima          String?  @db.VarChar(50) // Ej: "Soleado", "Lluvioso"
  temperatura_c  Decimal? @db.Decimal(4, 1) // Temperatura ambiente

  // Contenido
  actividades_realizadas String  @db.Text // Descripción detallada
  personal_en_sitio      Int     @default(0) // Número de personas
  incidencias            String? @db.Text // Accidentes, paros, etc.
  material_recibido      String? @db.Text // Materiales llegados hoy
  observaciones          String? @db.Text // Notas generales

  // Firmas y estado
  residente_id       String  @db.Uuid // UUID del residente (ref Auth)
  residente_nombre   String  @db.VarChar(200) // Nombre desnormalizado
  superintendente_id String? @db.Uuid
  estado             String  @default("BORRADOR") // BORRADOR, FIRMADA, CERRADA

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  @@unique([tenant_id, proyecto_id, numero_entrada])
  @@index([tenant_id, proyecto_id])
  @@index([tenant_id, proyecto_id, fecha])
  @@map("bitacoras_obra")
}

// ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
// ENTIDAD: Avance Físico
// Registra el porcentaje de avance de un concepto del presupuesto base.
// Es la base sobre la cual se construyen las Estimaciones.
// Referencia externa: concepto_id → Gerencia Técnica (vía API)
// ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━

model AvanceFisico {
  id_avance            String  @id @default(uuid()) @db.Uuid
  tenant_id            String  @db.Uuid
  proyecto_id          String  @db.Uuid
  concepto_id          String? @db.Uuid // Referencia real al Concepto de gerencia-tecnica (cross-service, sin FK)
  concepto_presupuesto String  @db.VarChar(100) // Clave del concepto (ej: "CIM-001")
  descripcion_concepto String  @db.VarChar(500) // Descripción corta

  // Cantidades
  cantidad_presupuestada Decimal @db.Decimal(18, 4) // Cantidad total del presupuesto
  cantidad_anterior      Decimal @default(0) @db.Decimal(18, 4) // Avance acumulado previo
  cantidad_periodo       Decimal @db.Decimal(18, 4) // Avance de este periodo
  cantidad_acumulada     Decimal @db.Decimal(18, 4) // anterior + periodo
  unidad                 String  @db.VarChar(20) // m³, kg, m², pza, etc.
  precio_unitario        Decimal @db.Decimal(18, 4) // PU del presupuesto base
  importe_periodo        Decimal @db.Decimal(18, 2) // cantidad_periodo × PU
  importe_acumulado      Decimal @db.Decimal(18, 2) // cantidad_acumulada × PU

  // Porcentaje
  porcentaje_avance Decimal @db.Decimal(5, 2) // (acumulada / presupuestada) × 100

  // Registro
  periodo_inicio        DateTime @db.Date // Inicio del periodo de medición
  periodo_fin           DateTime @db.Date // Fin del periodo
  registrado_por_id     String   @db.Uuid // Residente que midió
  registrado_por_nombre String   @db.VarChar(200)
  validado_por_id       String?  @db.Uuid // Superintendente que validó
  validado_por_nombre   String?  @db.VarChar(200)
  estado                String   @default("PENDIENTE") // PENDIENTE, VALIDADO, RECHAZADO

  // Vinculación a estimación (opcional, se llena al incluirlo en una)
  estimacion_id String?     @db.Uuid
  estimacion    Estimacion? @relation(fields: [estimacion_id], references: [id_estimacion])

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  @@index([tenant_id, proyecto_id])
  @@index([tenant_id, proyecto_id, estado])
  @@index([tenant_id, proyecto_id, concepto_id])
  @@map("avances_fisicos")
}

// ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
// ENTIDAD: Material Consumido en Obra
// Creado por suscriptor almacen.salida_obra. Registra el costo real de
// materiales por partida (concepto) del presupuesto base.
//
// NOTA: este modelo refleja la tabla REAL de bocam_control_obra en
// producción, no el modelo previo (obsoleto/nunca sincronizado) que
// declaraba movimiento_id/clave_insumo/descripcion/costo_pendiente/
// concepto_clave — columnas que no existen en prod. El código de
// apps/control-obra/src/main.ts (suscriptor de almacen.salida_obra)
// escribía contra esas columnas inexistentes; nunca se detectó porque el
// evento almacen.salida_obra nunca se disparó en producción (0 filas en
// la tabla real). Corregido como parte de la fusión (openspec:
// fusionar-control-obra-a-control-proyectos) — ver tarea 2.3.
// ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━

model MaterialConsumidoObra {
  id                    String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenant_id             String   @db.Uuid
  proyecto_id           String   @db.Uuid
  concepto_id           String   @db.Uuid
  movimiento_almacen_id String   @unique @db.Uuid
  insumo_id             String   @db.Uuid
  insumo_clave          String?  @db.VarChar(50)
  insumo_nombre         String?  @db.VarChar(255)
  cantidad              Decimal  @db.Decimal(18, 4)
  unidad                String   @db.VarChar(20)
  costo_unitario        Decimal? @db.Decimal(18, 2)
  costo_total           Decimal? @db.Decimal(18, 2)
  fecha                 DateTime @default(dbgenerated("CURRENT_DATE")) @db.Date
  frente_trabajo        String?  @db.VarChar(100)
  registrado_por        String?  @db.Uuid
  created_at            DateTime @default(now()) @db.Timestamptz(6)

  @@index([tenant_id, proyecto_id, concepto_id], name: "idx_mat_consumido_concepto")
  @@map("materiales_consumidos_obra")
}

// ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
// ENTIDAD: Estimación de Facturación
// Agrupa avances físicos validados en un documento oficial de cobro.
// Al ser aprobada, emite el evento EstimacionAprobada → Finanzas programa pago.
// ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━

model Estimacion {
  id_estimacion     String @id @default(uuid()) @db.Uuid
  tenant_id         String @db.Uuid
  proyecto_id       String @db.Uuid
  numero_estimacion Int // Consecutivo: Estimación 1, 2, 3...
  codigo            String @db.VarChar(50) // Ej: "EST-2026-GUA-003"

  // Periodo que cubre
  periodo_inicio DateTime @db.Date
  periodo_fin    DateTime @db.Date

  // Montos calculados (suma de avances incluidos)
  subtotal                 Decimal @db.Decimal(18, 2)
  retencion_fondo_garantia Decimal @default(0) @db.Decimal(18, 2) // 5% típico
  amortizacion_anticipo    Decimal @default(0) @db.Decimal(18, 2)
  iva                      Decimal @default(0) @db.Decimal(18, 2)
  total_neto               Decimal @db.Decimal(18, 2) // Lo que realmente se factura

  // Workflow de aprobación
  estado               String    @default("BORRADOR") // BORRADOR, EN_REVISION, APROBADA_TECNICA, APROBADA_FINANCIERA, RECHAZADA, FACTURADA
  elaborado_por_id     String    @db.Uuid // Residente
  elaborado_por_nombre String    @db.VarChar(200)
  revisado_por_id      String?   @db.Uuid // Superintendente
  revisado_por_nombre  String?   @db.VarChar(200)
  aprobado_por_id      String?   @db.Uuid // Director / Gerente
  aprobado_por_nombre  String?   @db.VarChar(200)
  fecha_aprobacion     DateTime?
  notas                String?   @db.Text

  // Relación con avances
  avances AvanceFisico[]

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  @@unique([tenant_id, proyecto_id, numero_estimacion])
  @@unique([tenant_id, codigo])
  @@index([tenant_id, proyecto_id])
  @@index([tenant_id, proyecto_id, estado])
  @@map("estimaciones")
}
