// -----------------------------------------------------------------------------
// Propiedad Intelectual: Constructora Bocam, S. A. de C.V.
// Módulo: Auth (IAM — Identity & Access Management)
//
// ARQUITECTURA:
// Este esquema es INDEPENDIENTE de los demás módulos (Soberanía de Datos).
// Contiene ÚNICAMENTE las tablas de identidad y sesiones.
// Los demás módulos referencian a los usuarios por UUID, nunca por JOIN cruzado.
// -----------------------------------------------------------------------------

generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// --- Entidad MDM: Tenant (Constructora / Cliente del SaaS) ---
model Tenant {
  id_tenant    String   @id @default(uuid()) @db.Uuid
  nombre       String   @db.VarChar(255)
  rfc          String?  @db.VarChar(20)
  logo_url     String?  @db.VarChar(500)
  primary_color String? @db.VarChar(50) // HSL value para White-Label
  plan         String   @default("BASICO") // BASICO, PROFESIONAL, ENTERPRISE
  activo       Boolean  @default(true)
  created_at   DateTime @default(now())

  usuarios     User[]
  proyectos    Proyecto[]

  @@map("tenants")
}

// --- Entidad MDM: Proyecto (Centro de Costos / Sucursal) ---
model Proyecto {
  id_proyecto          String   @id @default(uuid()) @db.Uuid
  tenant_id            String   @db.Uuid
  // Para proyectos creados antes de centro-costos-alta-formal: texto libre
  // (ej. 'CC-2026-GUA-01'), sin garantía de formato. Para proyectos nuevos:
  // ensamblado a partir de empresa_grupo+anio_centro_costos+cliente+consecutivo
  // (13 posiciones), salvo es_especial=true (texto libre también en ese caso).
  codigo_centro_costos String   @db.VarChar(50)
  nombre_oficial       String   @db.VarChar(255)
  tipo_contrato        String   @default("PRECIOS_UNITARIOS") // PRECIOS_UNITARIOS, PRECIO_ALZADO, EPC, MIXTO
  moneda_base          String   @default("MXN") @db.VarChar(5)
  estatus              String   @default("ABIERTO") // ABIERTO, EN EJECUCIÓN, EN COBRO, TERMINADO, CERRADO
  activo               Boolean  @default(true)
  created_at           DateTime @default(now())

  // ── Centro de Costos: componentes estructurados del código de 13 posiciones ──
  // Nullable: solo se completan para proyectos creados vía el flujo formal de
  // este cambio. Proyectos legacy quedan con estos campos en null.
  empresa_grupo             String?  @db.VarChar(3)  // CIB | HCO | HSE | SEO
  anio_centro_costos        Int?
  cliente_id                String?  @db.Uuid         // referencia lógica a Ventas.Cliente, sin FK cross-servicio
  consecutivo_centro_costos Int?
  es_especial               Boolean  @default(false)
  tipo_especial              String?  @db.VarChar(20) // OFICINA | TALLER | ALMACÉN, solo si es_especial

  // ── Línea base financiera y de plazos ──────────────────────────────────────
  fecha_inicio_real         DateTime?
  fecha_firma_contrato      DateTime?
  fecha_programada_inicio   DateTime?
  fecha_programada_fin      DateTime?
  monto_total_vendido       Decimal?  @db.Decimal(18, 2) // sin IVA
  periodo_ejecucion         Int?
  periodo_ejecucion_unidad  String?   @db.VarChar(10) // MESES | SEMANAS
  total_dias_naturales      Int?
  total_dias_laborables     Int?

  tenant               Tenant   @relation(fields: [tenant_id], references: [id_tenant], onDelete: Cascade)
  asignaciones         UserProjectAccess[]

  @@unique([tenant_id, codigo_centro_costos])
  @@index([tenant_id])
  @@index([tenant_id, empresa_grupo, anio_centro_costos, cliente_id])
  @@map("proyectos")
}

// --- Entidad MDM: Usuario_Identidad (Colaborador / Aprobador) ---
model User {
  id_usuario                String    @id @default(uuid()) @db.Uuid
  tenant_id                 String    @db.Uuid
  email                     String    @db.VarChar(255)
  password_hash             String    @db.VarChar(255)
  nombre                    String    @db.VarChar(150)
  rol_global                String[]  // Ej: ['superintendent', 'admin']
  limite_aprobacion_financiera Decimal @default(0) @db.Decimal(18, 2)
  activo                    Boolean   @default(true)
  created_at                DateTime  @default(now())
  updated_at                DateTime  @updatedAt

  tenant                    Tenant    @relation(fields: [tenant_id], references: [id_tenant], onDelete: Cascade)
  tokens                    RefreshToken[]
  proyectos_acceso          UserProjectAccess[]

  @@unique([tenant_id, email])
  @@index([tenant_id])
  @@map("users")
}

// --- Tabla Puente: Acceso de Usuario a Proyectos ---
// Implementa la directiva RBAC: "proyectos_autorizados (Array de UUIDs)"
model UserProjectAccess {
  id           String   @id @default(uuid()) @db.Uuid
  user_id      String   @db.Uuid
  proyecto_id  String   @db.Uuid
  rol_proyecto String?  @db.VarChar(50) // Rol específico en este proyecto (override)
  created_at   DateTime @default(now())

  user         User     @relation(fields: [user_id], references: [id_usuario], onDelete: Cascade)
  proyecto     Proyecto @relation(fields: [proyecto_id], references: [id_proyecto], onDelete: Cascade)

  @@unique([user_id, proyecto_id])
  @@map("user_project_access")
}

// --- Sesiones: Refresh Tokens (Rotación Segura) ---
model RefreshToken {
  id           String   @id @default(uuid()) @db.Uuid
  user_id      String   @db.Uuid
  token_hash   String   @db.VarChar(255) // Almacenar hash, NUNCA el token raw
  expires_at   DateTime
  revoked      Boolean  @default(false)
  created_at   DateTime @default(now())
  user_agent   String?  @db.VarChar(500)
  ip_address   String?  @db.VarChar(50)
  // Momento del login ORIGINAL de esta cadena de sesión — se propaga sin
  // resetear en cada rotación (ver apps/auth/src/sesion-policy.ts). Permite
  // imponer un límite absoluto de duración de sesión independiente de la
  // actividad del usuario. Nullable: tokens emitidos antes de este campo.
  sesion_iniciada_en DateTime?

  user         User     @relation(fields: [user_id], references: [id_usuario], onDelete: Cascade)

  @@index([user_id])
  @@index([token_hash])
  @@map("refresh_tokens")
}

// --- Audit Log de Operaciones Master (cross-tenant, sin RLS) ---
// Solo accesible vía runAsSystem. Registra CREATE/UPDATE/DELETE de tenants
// y accesos no autorizados. Best-effort: no bloquea el flujo principal.
model MasterAuditLog {
  id          String   @id @default(uuid()) @db.Uuid
  accion      String   @db.VarChar(50)
  entity_type String   @db.VarChar(30)
  entity_id   String?  @db.Uuid
  ip_address  String?  @db.VarChar(50)
  user_agent  String?  @db.VarChar(500)
  payload     Json?
  status_code Int
  error_msg   String?  @db.Text
  created_at  DateTime @default(now())

  @@index([created_at])
  @@index([entity_id])
  @@map("master_audit_logs")
}

// --- Audit Log de Acciones de Negocio por Tenant (RLS habilitado) ---
// Proyección derivada de eventos ya publicados a bocam.events por otros
// servicios (compras, finanzas) — no es la fuente de verdad transaccional.
// Best-effort: un fallo al persistir no bloquea al publisher del evento.
// Ver openspec/changes/auditoria-acciones-tenant.
model TenantAuditLog {
  id             String   @id @default(uuid()) @db.Uuid
  tenant_id      String   @db.Uuid
  proyecto_id    String   @db.Uuid
  actor_user_id  String   @db.Uuid
  event_type     String   @db.VarChar(100)
  entity_id      String?  @db.Uuid
  payload        Json?
  correlation_id String?  @db.VarChar(100)
  created_at     DateTime @default(now())

  @@index([tenant_id, created_at])
  @@map("tenant_audit_logs")
}
