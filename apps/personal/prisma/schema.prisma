// -----------------------------------------------------------------------------
// Propiedad Intelectual: Constructora Bocam, S. A. de C.V.
// Módulo: Personal / RRHH
// Clasificación: Estrictamente Confidencial.
//
// Entidades propias de este módulo:
// 1. Empleado        — Ficha del trabajador (RFC, CURP, puesto, contrato)
// 2. Cuadrilla        — Grupo de trabajo con capataz asignado
// 3. AsignacionFrente — Registro de personal enviado a frentes por periodo
// 4. PreNomina        — Cálculo pre-nómina semanal/quincenal
// -----------------------------------------------------------------------------

generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
// ENTIDAD 1: Empleado
// Ficha maestra del trabajador. Incluye datos fiscales, puesto,
// tipo de contrato y estado activo/baja.
// ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━

model Empleado {
  id_empleado       String   @id @default(uuid()) @db.Uuid
  tenant_id         String   @db.Uuid
  numero_empleado   String   @db.VarChar(20)        // Ej: "EMP-001"
  nombre            String   @db.VarChar(150)
  apellido_paterno  String   @db.VarChar(100)
  apellido_materno  String?  @db.VarChar(100)
  rfc               String   @db.VarChar(13)
  curp              String?  @db.VarChar(18)
  nss               String?  @db.VarChar(11)        // Número Seguro Social (IMSS)

  // Puesto y contrato
  puesto            String   @db.VarChar(100)       // Ej: "Fierrero", "Operador de Maquinaria"
  categoria         String   @default("OBRERO")     // OBRERO, TECNICO, ADMINISTRATIVO, SUPERVISOR
  tipo_contrato     String   @default("PLANTA")     // PLANTA, EVENTUAL, SUBCONTRATO
  fecha_ingreso     DateTime @db.Date
  fecha_baja        DateTime? @db.Date
  salario_diario    Decimal  @db.Decimal(10, 2)
  salario_integrado Decimal? @db.Decimal(10, 2)     // Para cálculo IMSS
  salario_acordado  Decimal? @db.Decimal(10, 2)     // Salario real total acordado (para Complemento Salarial)

  // Contacto
  telefono          String?  @db.VarChar(20)
  email             String?  @db.VarChar(100)
  contacto_emergencia String? @db.VarChar(200)

  // Certificaciones HSE
  certificaciones   String?  @db.Text               // JSON: ["DC3-Alturas", "STyPS-01"]

  // Estado
  estado            String   @default("ACTIVO")     // ACTIVO, BAJA, SUSPENDIDO, VACACIONES

  // Jornada laboral
  modo_asistencia        String   @default("JORNADA_COMPLETA") // JORNADA_COMPLETA | POR_HORAS
  tipo_jornada           String   @default("DIURNA")           // DIURNA | NOCTURNA | MIXTA
  hora_entrada_programada String? @db.VarChar(5)               // HH:MM — obligatorio si POR_HORAS
  hora_salida_programada  String? @db.VarChar(5)               // HH:MM
  horas_jornada           Decimal @default(8) @db.Decimal(4, 2) // Duración jornada normal

  // Relaciones
  cuadrilla_id      String?  @db.Uuid
  cuadrilla         Cuadrilla? @relation(fields: [cuadrilla_id], references: [id_cuadrilla])
  asignaciones      AsignacionFrente[]
  prenominas        PreNominaDetalle[]
  documentos        DocumentoEmpleado[]
  asignacionesResidente AsignacionResidente[]
  credenciales      CredencialEmpleado[]

  created_at        DateTime @default(now())
  updated_at        DateTime @updatedAt

  @@unique([tenant_id, numero_empleado])
  @@unique([tenant_id, rfc])
  @@index([tenant_id])
  @@index([tenant_id, estado])
  @@map("empleados")
}

// ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
// ENTIDAD 2: Cuadrilla
// Grupo de trabajo dirigido por un capataz. Se asigna completa a un frente.
// ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━

model Cuadrilla {
  id_cuadrilla     String   @id @default(uuid()) @db.Uuid
  tenant_id        String   @db.Uuid
  proyecto_id      String   @db.Uuid
  nombre           String   @db.VarChar(100)        // Ej: "Cuadrilla Alfa - Cimentación"
  codigo           String   @db.VarChar(20)         // Ej: "CUA-01"
  especialidad     String   @db.VarChar(100)        // Ej: "Cimentación", "Estructura", "Acabados"
  capataz_id       String?  @db.Uuid                // ID del empleado líder
  capataz_nombre   String?  @db.VarChar(200)
  estado           String   @default("ACTIVA")      // ACTIVA, INACTIVA, REUBICADA

  miembros         Empleado[]
  asignaciones     AsignacionFrente[]

  created_at       DateTime @default(now())
  updated_at       DateTime @updatedAt

  @@unique([tenant_id, proyecto_id, codigo])
  @@index([tenant_id, proyecto_id])
  @@map("cuadrillas")
}

// ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
// ENTIDAD 3: Asignación a Frente
// Registra qué cuadrilla o empleado está asignado a qué frente de trabajo,
// en qué turno y durante qué periodo. Permite calcular horas-hombre.
// ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━

model AsignacionFrente {
  id_asignacion    String   @id @default(uuid()) @db.Uuid
  tenant_id        String   @db.Uuid
  proyecto_id      String   @db.Uuid
  empleado_id      String   @db.Uuid
  cuadrilla_id     String?  @db.Uuid
  frente_trabajo   String   @db.VarChar(100)        // Ej: "Frente 1 — Cimentación"
  turno            String   @default("DIURNO")      // DIURNO, NOCTURNO, MIXTO
  fecha_inicio     DateTime @db.Date
  fecha_fin        DateTime? @db.Date
  horas_diarias    Decimal  @db.Decimal(4, 2) @default(8)
  estado           String   @default("ACTIVA")      // ACTIVA, COMPLETADA, CANCELADA
  // true = préstamo temporal a este proyecto (spec 02, sección 3), no
  // asignación estructural — distingue en listados/UI sin cambiar la
  // elegibilidad de nómina (obtenerEmpleadoIdsDelProyecto no filtra por esto).
  es_prestamo      Boolean  @default(false)

  empleado         Empleado  @relation(fields: [empleado_id], references: [id_empleado])
  cuadrilla        Cuadrilla? @relation(fields: [cuadrilla_id], references: [id_cuadrilla])

  created_at       DateTime @default(now())

  @@index([tenant_id, proyecto_id])
  @@index([tenant_id, proyecto_id, frente_trabajo])
  @@map("asignaciones_frente")
}

// ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
// ENTIDAD 4: Pre-Nómina
// Cálculo semanal/quincenal de la nómina antes de aprobación.
// Agrupa detalles individuales por empleado.
// Al autorizarse, emite evento PreNominaAutorizada → Finanzas.
// ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━

model PreNomina {
  id_prenomina     String   @id @default(uuid()) @db.Uuid
  tenant_id        String   @db.Uuid
  proyecto_id      String   @db.Uuid
  codigo           String   @db.VarChar(50)         // Ej: "NOM-2026-S12"
  periodo_tipo     String   @default("SEMANAL")     // SEMANAL, QUINCENAL
  periodo_inicio   DateTime @db.Date
  periodo_fin      DateTime @db.Date
  total_percepciones Decimal @db.Decimal(18, 2) @default(0)
  total_deducciones  Decimal @db.Decimal(18, 2) @default(0)
  total_neto         Decimal @db.Decimal(18, 2) @default(0)
  total_empleados    Int     @default(0)
  estado           String   @default("BORRADOR")    // BORRADOR, CALCULADA, AUTORIZADA, PAGADA
  requiere_recalculo Boolean @default(false)        // true = calculado con tasas antiguas
  elaborado_por    String   @db.Uuid
  autorizado_por   String?  @db.Uuid
  fecha_autorizacion DateTime?
  notas            String?  @db.Text

  detalles         PreNominaDetalle[]

  created_at       DateTime @default(now())
  updated_at       DateTime @updatedAt

  @@unique([tenant_id, codigo])
  @@index([tenant_id, proyecto_id])
  @@map("pre_nominas")
}

model PreNominaDetalle {
  id_detalle       String   @id @default(uuid()) @db.Uuid
  tenant_id        String   @db.Uuid
  proyecto_id      String   @db.Uuid
  prenomina_id     String   @db.Uuid
  empleado_id      String   @db.Uuid

  // Cálculo
  origen_dias      String   @default("ASISTENCIA") // ASISTENCIA | ESTIMADO
  dias_trabajados  Decimal  @db.Decimal(4, 1)
  horas_extra      Decimal  @db.Decimal(6, 2) @default(0)
  salario_base     Decimal  @db.Decimal(10, 2)      // salario_diario × días (JORNADA) o horas_normales × tarifa (POR_HORAS)
  monto_horas_extra Decimal @db.Decimal(10, 2) @default(0)
  bonos            Decimal  @db.Decimal(10, 2) @default(0)
  total_percepciones Decimal @db.Decimal(10, 2)
  deduccion_imss   Decimal  @db.Decimal(10, 2) @default(0)
  deduccion_isr    Decimal  @db.Decimal(10, 2) @default(0)
  otras_deducciones Decimal @db.Decimal(10, 2) @default(0)
  total_deducciones Decimal @db.Decimal(10, 2) @default(0)
  neto_a_pagar     Decimal  @db.Decimal(10, 2)

  // Campos exclusivos para modo POR_HORAS
  horas_normales   Decimal? @db.Decimal(6, 2)        // total horas normales del período
  monto_he_doble   Decimal  @default(0) @db.Decimal(10, 2) // HE al 200% (primeras 9h/sem)
  monto_he_triple  Decimal  @default(0) @db.Decimal(10, 2) // HE al 300% (excedente 9h/sem)
  origen_horas     String   @default("REAL")          // REAL | ESTIMADO

  prenomina        PreNomina @relation(fields: [prenomina_id], references: [id_prenomina], onDelete: Cascade)
  empleado         Empleado  @relation(fields: [empleado_id], references: [id_empleado])

  @@index([tenant_id, prenomina_id])
  @@map("pre_nomina_detalles")
}

// ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
// ENTIDAD 5: Registro de Asistencia
// Registro diario de asistencia por empleado. Alimenta el motor de nómina.
// ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━

model RegistroAsistencia {
  id_registro    String   @id @default(uuid()) @db.Uuid
  tenant_id      String   @db.Uuid
  proyecto_id    String   @db.Uuid
  empleado_id    String   @db.Uuid
  cuadrilla_id   String?  @db.Uuid
  fecha          DateTime @db.Date
  estado              String   // PRESENTE | AUSENTE | INCAPACIDAD | JUSTIFICADA | FALTA
  tipo_registro       String   @default("MANUAL") // QR | MANUAL
  horas_extra         Decimal  @default(0) @db.Decimal(4, 1)
  registrado_por      String   @db.Uuid

  // Campos de jornada POR_HORAS
  hora_entrada        String?  @db.VarChar(5)           // HH:MM — primer scan / manual
  hora_salida         String?  @db.VarChar(5)           // HH:MM — segundo scan / manual
  horas_trabajadas    Decimal? @db.Decimal(4, 2)        // calculado: salida − entrada
  horas_normales      Decimal? @db.Decimal(4, 2)        // min(horas_trabajadas, jornada)
  horas_extra_dia     Decimal? @db.Decimal(4, 2)        // max(0, trabajadas − jornada)
  origen_horas        String   @default("REAL")         // REAL | ESTIMADO
  ultimo_scan_en      DateTime?                         // marca de tiempo exacta del último escaneo (cooldown anti-rescaneo)

  created_at          DateTime @default(now())

  @@unique([tenant_id, empleado_id, fecha])
  @@index([tenant_id, proyecto_id, fecha])
  @@index([tenant_id, empleado_id])
  @@map("registros_asistencia")
}

// ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
// ENTIDAD 6: Configuración de Deducciones por Empleado
// ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━

model ConfigDeduccionEmpleado {
  id_config        String   @id @default(uuid()) @db.Uuid
  tenant_id        String   @db.Uuid
  empleado_id      String   @db.Uuid
  aplica_imss      Boolean  @default(true)
  aplica_isr       Boolean  @default(true)
  aplica_infonavit Boolean  @default(false)
  infonavit_num    String?  @db.VarChar(30)
  infonavit_monto  Decimal? @db.Decimal(10, 2)

  updated_at       DateTime @updatedAt

  @@unique([tenant_id, empleado_id])
  @@index([tenant_id])
  @@map("config_deducciones_empleados")
}

// ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
// ENTIDAD 7: Complemento Salarial
// Segunda nómina sin deducciones: diferencia entre salario acordado y IMSS.
// ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━

model NominaComplementaria {
  id_complemento    String   @id @default(uuid()) @db.Uuid
  tenant_id         String   @db.Uuid
  proyecto_id       String   @db.Uuid
  prenomina_id      String   @db.Uuid
  codigo            String   @db.VarChar(30)  // CS-2026-S01
  periodo_inicio    DateTime @db.Date
  periodo_fin       DateTime @db.Date
  periodo_tipo      String   // SEMANAL | QUINCENAL
  total_complemento Decimal  @db.Decimal(12, 2)
  estado            String   @default("BORRADOR") // BORRADOR | AUTORIZADA
  elaborado_por     String   @db.Uuid
  autorizado_por    String?  @db.Uuid

  created_at        DateTime @default(now())
  detalles          NominaComplementariaDetalle[]

  @@index([tenant_id, proyecto_id])
  @@map("nominas_complementarias")
}

model NominaComplementariaDetalle {
  id_detalle        String   @id @default(uuid()) @db.Uuid
  tenant_id         String   @db.Uuid
  complemento_id    String   @db.Uuid
  empleado_id       String   @db.Uuid
  dias_trabajados   Decimal  @db.Decimal(4, 1)
  salario_acordado  Decimal  @db.Decimal(10, 2)
  salario_imss_dia  Decimal  @db.Decimal(10, 2)
  complemento_dia   Decimal  @db.Decimal(10, 2)
  monto_complemento Decimal  @db.Decimal(10, 2)

  complemento       NominaComplementaria @relation(fields: [complemento_id], references: [id_complemento], onDelete: Cascade)

  @@index([tenant_id, complemento_id])
  @@map("nominas_complementarias_detalle")
}

// ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
// ENTIDAD 8: Config Nómina por Proyecto
// Periodicidad de pago (SEMANAL/QUINCENAL/MENSUAL) configurada por RH a
// nivel proyecto. Los empleados asignados al proyecto la heredan
// automáticamente — no existe periodicidad por empleado.
// ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━

model ConfigNominaProyecto {
  id_config        String   @id @default(uuid()) @db.Uuid
  tenant_id        String   @db.Uuid
  proyecto_id      String   @db.Uuid
  periodicidad_pago String  @default("SEMANAL") // SEMANAL | QUINCENAL | MENSUAL
  configurado_por  String   @db.Uuid
  updated_at       DateTime @updatedAt

  @@unique([tenant_id, proyecto_id])
  @@map("config_nomina_proyecto")
}

// ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
// ENTIDAD 9: Documento de Expediente del Empleado
// INE, comprobante de domicilio, constancias de curso/capacitación, etc.
// Almacenamiento en volumen propio (no depende de Calidad).
// ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━

model DocumentoEmpleado {
  id_documento   String    @id @default(uuid()) @db.Uuid
  tenant_id      String    @db.Uuid
  empleado_id    String    @db.Uuid
  tipo_documento String    // INE | COMPROBANTE_DOMICILIO | CURSO_CAPACITACION | CONTRATO | OTRO
  nombre_archivo String    @db.VarChar(255)
  ruta_archivo   String    @db.VarChar(500)
  mime_type      String    @db.VarChar(100)
  tamano_bytes   Int
  fecha_vigencia DateTime? @db.Date
  subido_por     String    @db.Uuid
  created_at     DateTime  @default(now())

  empleado       Empleado  @relation(fields: [empleado_id], references: [id_empleado])

  @@index([tenant_id, empleado_id])
  @@index([tenant_id, fecha_vigencia])
  @@map("documentos_empleado")
}

// ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
// ENTIDAD 10: Asignación de Empleado a Residente(s)
// Relación N:N con historial simple (fecha_fin nula = vigente). residente_id
// es una referencia opaca a un usuario de `auth` (sin JOIN cruzado).
// ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━

model AsignacionResidente {
  id_asignacion  String    @id @default(uuid()) @db.Uuid
  tenant_id      String    @db.Uuid
  empleado_id    String    @db.Uuid
  residente_id   String    @db.Uuid
  fecha_inicio   DateTime  @default(now())
  fecha_fin      DateTime?
  asignado_por   String    @db.Uuid
  // Un empleado puede tener varias asignaciones vigentes a la vez (personal
  // compartido, ver spec 02) — es_principal marca cuál es el residente "a
  // cargo por default" sin cerrar ni afectar a las demás. No es exclusividad,
  // es solo una etiqueta sobre asignaciones que siguen todas vigentes.
  es_principal   Boolean   @default(true)

  empleado       Empleado  @relation(fields: [empleado_id], references: [id_empleado])

  @@index([tenant_id, empleado_id])
  @@index([tenant_id, residente_id])
  @@map("asignaciones_residente")
}

// ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
// ENTIDAD 11: Credencial de Empleado
// Token opaco y revocable impreso como QR en la credencial física. Cada fila
// es un evento de emisión — revocar = activa=false, reemitir = fila nueva.
// El token NUNCA autentica por sí solo: la autorización real vive en la
// sesión JWT de quien escanea (ver asistencia-qr-segura).
// ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━

model CredencialEmpleado {
  id_credencial     String    @id @default(uuid()) @db.Uuid
  tenant_id         String    @db.Uuid
  empleado_id       String    @db.Uuid
  token             String    @db.VarChar(64)
  activa            Boolean   @default(true)
  emitida_en        DateTime  @default(now())
  emitida_por       String    @db.Uuid
  revocada_en       DateTime?
  revocada_por      String?   @db.Uuid
  motivo_revocacion String?   @db.VarChar(200)

  empleado          Empleado  @relation(fields: [empleado_id], references: [id_empleado])

  @@unique([tenant_id, token])
  @@index([tenant_id, empleado_id])
  @@map("credenciales_empleado")
}

// ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
// ENTIDAD 12: Config de Asistencia por Proyecto (geofencing opcional)
// Sin entidad Proyecto propia (mismo patrón que ConfigNominaProyecto). Si no
// existe fila para un proyecto, el escaneo no valida ubicación.
// ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━

model ConfigAsistenciaProyecto {
  id_config       String   @id @default(uuid()) @db.Uuid
  tenant_id       String   @db.Uuid
  proyecto_id     String   @db.Uuid
  lat             Decimal  @db.Decimal(9, 6)
  lng             Decimal  @db.Decimal(9, 6)
  radio_metros    Int      @default(300)
  configurado_por String   @db.Uuid
  updated_at      DateTime @updatedAt

  @@unique([tenant_id, proyecto_id])
  @@map("config_asistencia_proyecto")
}
