// -----------------------------------------------------------------------------
// Propiedad Intelectual: Constructora Bocam, S. A. de C.V.
// Módulo: Almacén (Inventario y Movimientos)
//
// ARQUITECTURA:
// Microservicio independiente separado de Compras.
// Consumidor de eventos RabbitMQ: compras.oc_recibida_total / compras.oc_recibida_parcial
// Las tablas son IDÉNTICAS a las que existían en compras, solo cambia el schema de BD.
// -----------------------------------------------------------------------------

generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model ItemInventario {
  id           String   @id @default(uuid()) @db.Uuid
  tenant_id    String   @db.Uuid
  proyecto_id  String   @db.Uuid
  insumo_id    String?  @db.Uuid
  clave        String   @db.VarChar(50)
  descripcion  String   @db.VarChar(255)
  unidad       String   @db.VarChar(20)
  categoria    String   @db.VarChar(50)
  stock_actual Decimal  @default(0) @db.Decimal(18, 4)
  stock_minimo Decimal  @default(0) @db.Decimal(18, 4)
  ubicacion    String?  @db.VarChar(100)
  created_at   DateTime @default(now())
  updated_at   DateTime @updatedAt

  movimientos MovimientoAlmacen[]

  @@index([tenant_id, proyecto_id])
  @@map("inventario_almacen")
}

model MovimientoAlmacen {
  id                String   @id @default(uuid()) @db.Uuid
  tenant_id         String   @db.Uuid
  proyecto_id       String   @db.Uuid
  item_id           String   @db.Uuid
  tipo              String   @db.VarChar(20) // INGRESO | EGRESO | TRASPASO | EGRESO_OBRA
  cantidad          Decimal  @db.Decimal(18, 4)
  unidad            String   @db.VarChar(20)
  origen            String?  @db.VarChar(100)
  destino           String?  @db.VarChar(100)
  responsable       String?  @db.VarChar(100)
  referencia        String?  @db.VarChar(50)
  fecha             DateTime @default(now())
  // Campos para EGRESO_OBRA (obligatorios cuando tipo=EGRESO_OBRA)
  concepto_id       String?  @db.Uuid
  concepto_clave    String?  @db.VarChar(100)
  frente_trabajo    String?  @db.VarChar(100)
  oc_item_id        String?  @db.Uuid
  // Idempotencia de los INGRESOS por recepción de OC (compras.recepcion_oc_registrada.v1).
  // NULL en los movimientos manuales y de obra: Postgres no considera iguales dos NULL,
  // por lo que la restricción única solo aplica a los INGRESOS que vienen de una recepción.
  recepcion_id      String?  @db.Uuid
  recepcion_item_id String?  @db.Uuid

  item ItemInventario @relation(fields: [item_id], references: [id], onDelete: Cascade)

  @@unique([tenant_id, proyecto_id, recepcion_id, recepcion_item_id], name: "uq_mov_recepcion_item")
  @@index([tenant_id, proyecto_id, fecha])
  @@index([tenant_id, proyecto_id, concepto_id])
  @@map("movimientos_almacen")
}

// Eventos del bus ya procesados por Almacén (idempotencia por event_id). Se inserta en la misma
// transacción que los movimientos: si el evento falla, el registro se revierte con ellos.
model EventoProcesado {
  id           String   @id @default(uuid()) @db.Uuid
  tenant_id    String   @db.Uuid
  proyecto_id  String   @db.Uuid
  event_id     String   @db.Uuid
  event_type   String   @db.VarChar(100)
  procesado_en DateTime @default(now())

  @@unique([tenant_id, event_id], name: "uq_evento_procesado")
  @@map("eventos_procesados")
}

// -----------------------------------------------------------------------------
// Activos fijos (equipo/herramienta/maquinaria/vehículos) — ver
// openspec/changes/control-almacen-activos. A diferencia de ItemInventario
// (stock consumible), un Activo se rastrea individualmente: no tiene
// cantidad, tiene un estado y una ubicación/asignación puntual.
// -----------------------------------------------------------------------------

model Activo {
  id_activo     String  @id @default(uuid()) @db.Uuid
  tenant_id     String  @db.Uuid
  numero_activo String  @db.VarChar(20) // "ACT-001"
  clave         String  @db.VarChar(50)
  descripcion   String  @db.VarChar(255)
  clasificacion String  @db.VarChar(20) // EQUIPO | HERRAMIENTA | MAQUINARIA | VEHICULO
  estado        String  @default("DISPONIBLE") @db.VarChar(20) // DISPONIBLE | ASIGNADO | EN_TRASPASO | BAJA
  proyecto_id   String  @db.Uuid
  ubicacion     String? @db.VarChar(100)

  asignado_a_empleado_id     String? @db.Uuid
  asignado_a_empleado_nombre String? @db.VarChar(200)

  fecha_alta        DateTime  @default(now())
  fecha_baja        DateTime?
  motivo_baja       String?   @db.VarChar(255)
  valor_adquisicion Decimal?  @db.Decimal(18, 2)

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  traspasos TraspasoActivo[]

  @@unique([tenant_id, numero_activo])
  @@index([tenant_id, proyecto_id])
  @@map("activos")
}

model TraspasoActivo {
  id_traspaso String @id @default(uuid()) @db.Uuid
  tenant_id   String @db.Uuid
  activo_id   String @db.Uuid
  tipo        String @db.VarChar(20) // PROYECTO | ASIGNACION | AMBOS
  estado      String @default("PENDIENTE") @db.VarChar(20) // PENDIENTE | CONFIRMADO | RECHAZADO

  proyecto_origen_id  String  @db.Uuid
  proyecto_destino_id String? @db.Uuid

  empleado_origen_id      String? @db.Uuid
  empleado_origen_nombre  String? @db.VarChar(200)
  empleado_destino_id     String? @db.Uuid
  empleado_destino_nombre String? @db.VarChar(200)

  solicitado_por String    @db.VarChar(200)
  solicitado_en  DateTime  @default(now())
  confirmado_por String?   @db.VarChar(200)
  rechazado_por  String?   @db.VarChar(200)
  resuelto_en    DateTime?
  notas          String?   @db.VarChar(500)

  activo Activo @relation(fields: [activo_id], references: [id_activo], onDelete: Cascade)

  @@index([tenant_id, activo_id])
  @@index([tenant_id, proyecto_destino_id, estado])
  @@map("traspasos_activos")
}
