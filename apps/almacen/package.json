{
  "name": "@bocam/almacen",
  "version": "1.0.0",
  "description": "Módulo de Almacén (Inventario y Movimientos) — Microservicio independiente",
  "main": "dist/main.js",
  "scripts": {
    "build": "tsc",
    "dev": "ts-node-dev --transpile-only src/main.ts",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "test:integration:api": "node -r ts-node/register/transpile-only test/integration/almacen-api.integration.test.ts",
    "test:integration:eventos-oc": "node -r ts-node/register/transpile-only test/integration/almacen-eventos-oc.integration.test.ts",
    "test:integration:salida-obra": "node -r ts-node/register/transpile-only test/integration/almacen-salida-obra.integration.test.ts",
    "test:integration:activos-crud": "node -r ts-node/register/transpile-only test/integration/activos-crud.integration.test.ts",
    "test:integration:activos-traspasos": "node -r ts-node/register/transpile-only test/integration/activos-traspasos.integration.test.ts"
  },
  "dependencies": {
    "@prisma/client": "^5.0.0",
    "amqplib": "^0.10.3",
    "express": "^4.18.2",
    "uuid": "^14.0.0"
  },
  "devDependencies": {
    "@types/amqplib": "^0.10.1",
    "@types/express": "^4.17.17",
    "@types/jsonwebtoken": "^9.0.0",
    "@types/node": "^20.0.0",
    "@types/uuid": "^9.0.2",
    "jsonwebtoken": "^9.0.0",
    "prisma": "^5.0.0",
    "ts-node": "^10.9.1",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.1.3"
  }
}
