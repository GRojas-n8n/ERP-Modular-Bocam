{
  "name": "@bocam/compras",
  "version": "1.0.0",
  "description": "Módulo de Compras y Procuración (Requisiciones y OC)",
  "main": "dist/main.js",
  "scripts": {
    "build": "tsc",
    "dev": "ts-node-dev --transpile-only src/main.ts",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "test:integration:finanzas-feedback": "node -r ts-node/register/transpile-only test/integration/finanzas.feedback.integration.test.ts",
    "test:e2e:reconciliacion": "node -r ts-node/register/transpile-only test/e2e/reconciliacion.e2e.test.ts",
    "test:e2e:seguridad": "node -r ts-node/register/transpile-only test/e2e/seguridad.e2e.test.ts",
    "test:integration:oc-error-alert": "node -r ts-node/register/transpile-only test/integration/oc-error-alert.integration.test.ts",
    "test:integration:dashboard-alertas-atorados": "node -r ts-node/register/transpile-only test/integration/dashboard-alertas-procesos-atorados.integration.test.ts",
    "test:integration:oc-enviar-correo": "node -r ts-node/register/transpile-only test/integration/orden-compra-enviar-correo.integration.test.ts",
    "test:integration:estado-respuesta-proveedor": "node -r ts-node/register/transpile-only test/integration/estado-respuesta-proveedor-comparativo.integration.test.ts",
    "test:integration:fecha-entrega-partida": "node -r ts-node/register/transpile-only test/integration/fecha-entrega-estimada-por-partida.integration.test.ts",
    "test:integration:fichas-tecnicas-adjuntas": "node -r ts-node/register/transpile-only test/integration/fichas-tecnicas-adjuntas.integration.test.ts",
    "test:integration:proveedores-importar-lote": "node -r ts-node/register/transpile-only test/integration/proveedores-importar-lote.integration.test.ts"
  },
  "dependencies": {
    "@prisma/client": "^5.0.0",
    "amqplib": "^0.10.3",
    "axios": "^1.18.1",
    "express": "^4.18.2",
    "multer": "^2.1.1",
    "nodemailer": "^9.0.3",
    "redis": "^4.6.7",
    "uuid": "^14.0.0"
  },
  "devDependencies": {
    "@types/amqplib": "^0.10.1",
    "@types/express": "^4.17.17",
    "@types/multer": "^2.2.0",
    "@types/node": "^20.0.0",
    "@types/nodemailer": "^8.0.1",
    "@types/uuid": "^9.0.2",
    "prisma": "^5.0.0",
    "ts-node": "^10.9.1",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.1.3"
  }
}
