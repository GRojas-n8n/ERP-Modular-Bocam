generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// --- Entidad 3 MDM: Proveedor (Tercero) ---
// Módulo Propietario: Finanzas (Simulado aquí para el MVP de Compras)
model Proveedor {
  id_proveedor   String   @id @default(uuid()) @db.Uuid
  tenant_id      String   @db.Uuid
  rfc_tax_id     String   @db.VarChar(20)
  razon_social   String   @db.VarChar(255)
  email_contacto String?  @db.VarChar(100)
  telefono       String?  @db.VarChar(20)
  estatus        String   @default("ACTIVO") // ACTIVO, VETADO, PENDIENTE

  // ── Segmentación Logística ───────────────────────────────────────────────
  ciudad           String?  @db.VarChar(100)
  tipo_ubicacion   String   @default("LOCAL") @db.VarChar(20)  // LOCAL | FORANEO
  entrega_en_sitio Boolean  @default(false)

  // ── Calificación Crediticia ──────────────────────────────────────────────
  estatus_credito  String   @default("ACTIVO") @db.VarChar(20) // ACTIVO | BLOQUEADO
  limite_credito   Decimal? @db.Decimal(18, 2)

  // ── Perfil de Cumplimiento ───────────────────────────────────────────────
  tipo_proveedor        String   @default("NACIONAL") @db.VarChar(20) // NACIONAL | EXTRANJERO
  calificacion_desempeno Decimal? @db.Decimal(3, 2) // 0.00–5.00

  ordenes        OrdenCompra[]
  comparativas   ComparativaDetalle[]
  documentos     DocumentoProveedor[]
  calificaciones CalificacionProveedor[]

  @@unique([tenant_id, rfc_tax_id])
  @@map("proveedores")
}

model CalificacionProveedor {
  id_calificacion      String   @id @default(uuid()) @db.Uuid
  tenant_id            String   @db.Uuid
  proveedor_id         String   @db.Uuid
  proyecto_id          String   @db.Uuid
  proyecto_nombre      String   @db.VarChar(255)
  puntuacion           Decimal  @db.Decimal(3, 2)
  comentario           String?  @db.Text
  calificado_por       String   @db.Uuid
  calificado_por_nombre String  @db.VarChar(255)
  created_at           DateTime @default(now())
  updated_at           DateTime @updatedAt

  proveedor  Proveedor @relation(fields: [proveedor_id], references: [id_proveedor], onDelete: Cascade)

  @@unique([tenant_id, proveedor_id, proyecto_id])
  @@index([tenant_id, proveedor_id])
  @@map("calificaciones_proveedor")
}

model DocumentoProveedor {
  id_doc       String   @id @default(uuid()) @db.Uuid
  tenant_id    String   @db.Uuid
  proveedor_id String   @db.Uuid
  tipo_doc     String   @db.VarChar(20)   // CSD | OPINION_SAT | ISO | OTRO
  nombre_doc   String   @db.VarChar(255)
  ruta_archivo String   @db.Text
  mime_type    String   @db.VarChar(100)
  tamano_bytes Int
  subido_por   String   @db.Uuid
  created_at   DateTime @default(now())

  proveedor    Proveedor @relation(fields: [proveedor_id], references: [id_proveedor], onDelete: Cascade)

  @@index([tenant_id, proveedor_id])
  @@map("documentos_proveedor")
}

// --- Transaccional: Requisiciones ---
model Requisicion {
  id_requisicion String   @id @default(uuid()) @db.Uuid
  tenant_id      String   @db.Uuid
  proyecto_id    String   @db.Uuid // Centro de Costos
  codigo         String   @db.VarChar(50) // Ej. REQ-2026-001
  fecha_solicitud DateTime @default(now())
  solicitante_id String   @db.Uuid // Referencia a Usuario_Identidad
  /// Nombre del solicitante al momento de crear la req (snapshot del JWT) — evita JOIN cruzado con Auth
  solicitante_nombre String? @db.VarChar(200)
  prioridad      String   @default("NORMAL") // BAJA, NORMAL, URGENTE
  estado         String   @default("PENDIENTE") // PENDIENTE, APROBADA, RECHAZADA, COMPRADA
  /// Tipo de requisición: NORMAL (con catálogo) | IMPREVISTO (texto libre, sin insumo_id)
  tipo           String   @default("NORMAL") @db.VarChar(20)
  observaciones  String?  @db.Text

  /// Partida del catálogo de conceptos a la que pertenece esta requisición (obligatorio en nuevas reqs)
  concepto_id    String?  @db.Uuid

  items          RequisicionItem[]

  @@unique([tenant_id, codigo])
  @@index([tenant_id, proyecto_id])
  @@index([tenant_id, tipo])
  @@index([tenant_id, concepto_id], name: "idx_req_concepto")
  @@map("requisiciones")
}

model RequisicionItem {
  id_item        String   @id @default(uuid()) @db.Uuid
  tenant_id      String   @db.Uuid
  proyecto_id    String   @db.Uuid
  requisicion_id String   @db.Uuid
  /// Nullable para ítems IMPREVISTO que no tienen entrada en el catálogo
  insumo_id      String?  @db.Uuid
  cantidad       Decimal  @db.Decimal(18, 4)
  notas          String?  @db.Text
  /// Para ítems de requisición IMPREVISTO: descripción libre sin catálogo
  descripcion_libre String? @db.Text
  /// Unidad de medida libre para ítems IMPREVISTO
  unidad_libre      String? @db.VarChar(20)
  /// Marcador de ítem imprevisto (sin insumo_id en catálogo)
  es_imprevisto     Boolean @default(false)

  // ── Especificaciones técnicas (Residente — v1 manual) ────────────────────
  /// Marca o modelo de referencia indicado por el Residente al crear la req
  especificacion_marca_modelo String? @db.VarChar(200)
  /// Especificaciones técnicas libres indicadas por el Residente
  especificacion_detalle      String? @db.Text

  // ── Trazabilidad de presupuesto ──────────────────────────────────────────
  /// Cantidad presupuestada para este insumo en el proyecto (snapshot al crear req)
  cantidad_presupuestada Decimal? @db.Decimal(18, 4)
  /// ID del concepto APU del catálogo del que proviene este insumo (nullable si es imprevisto)
  concepto_origen_id     String?  @db.Uuid
  /// Justificación obligatoria cuando excede presupuesto o es imprevisto
  justificacion          String?  @db.Text

  requisicion    Requisicion @relation(fields: [requisicion_id], references: [id_requisicion], onDelete: Cascade)

  @@index([tenant_id, requisicion_id])
  @@index([tenant_id, proyecto_id, insumo_id])
  @@map("requisiciones_items")
}

// ── Incisos extra: gastos fuera de presupuesto asignados a una partida del catálogo ──
// Permite que un material imprevisto o en excedente se vincule a un concepto APU,
// sumando su monto al total de esa partida para reportes de control presupuestal.
model AsignacionExtraConcepto {
  id_asignacion        String   @id @default(uuid()) @db.Uuid
  tenant_id            String   @db.Uuid
  proyecto_id          String   @db.Uuid
  requisicion_item_id  String   @db.Uuid   // ref a RequisicionItem.id_item
  concepto_id          String   @db.Uuid   // ref a concepto en gerencia-tecnica (UUID solo, sin @relation)
  concepto_clave       String   @db.VarChar(100)  // desnormalizado para evitar JOIN cross-module
  concepto_descripcion String   @db.Text           // desnormalizado
  monto_extra          Decimal  @db.Decimal(18, 4)
  asignado_por         String   @db.Uuid
  created_at           DateTime @default(now())

  @@unique([tenant_id, requisicion_item_id])   // un ítem → un concepto destino
  @@index([tenant_id, proyecto_id])
  @@index([tenant_id, concepto_id])
  @@map("asignaciones_extra_concepto")
}

// --- Transaccional: Órdenes de Compra ---
model OrdenCompra {
  id_orden      String   @id @default(uuid()) @db.Uuid
  tenant_id     String   @db.Uuid
  proyecto_id   String   @db.Uuid // Centro de Costos
  proveedor_id  String   @db.Uuid
  codigo        String   @db.VarChar(50) // Ej. OC-2026-001
  fecha_emision DateTime @default(now())
  estado        String   @default("BORRADOR") // BORRADOR, PENDIENTE, APROBADA, EMITIDA, PARCIALMENTE_RECIBIDA, RECIBIDA, CANCELADA
  estado_pago   String   @default("PENDIENTE_PAGO") // PENDIENTE_PAGO, PAGO_PARCIAL, PAGADA
  moneda        String   @default("MXN")
  tipo_cambio   Decimal  @db.Decimal(18, 4) @default(1.0)
  subtotal      Decimal  @db.Decimal(18, 2)
  iva           Decimal  @db.Decimal(18, 2)
  total         Decimal  @db.Decimal(18, 2)
  presupuesto_id String? @db.Uuid // Referencia externa al Módulo de Finanzas
  /// Requisición que originó esta OC — para cálculo de acumulados por partida
  requisicion_id String? @db.Uuid

  proveedor     Proveedor @relation(fields: [proveedor_id], references: [id_proveedor])
  items         OrdenCompraItem[]
  recepciones   RecepcionOC[]

  @@unique([tenant_id, codigo])
  @@index([tenant_id, proyecto_id])
  @@index([tenant_id, requisicion_id], name: "idx_oc_requisicion")
  @@map("ordenes_compra")
}

model OrdenCompraItem {
  id_item        String   @id @default(uuid()) @db.Uuid
  tenant_id      String   @db.Uuid
  proyecto_id    String   @db.Uuid
  orden_id       String   @db.Uuid
  insumo_id      String   @db.Uuid // Referencia a MDM: Insumo_Catalogo
  cantidad       Decimal  @db.Decimal(18, 4)
  precio_unitario Decimal @db.Decimal(18, 4)
  importe        Decimal  @db.Decimal(18, 2)

  orden          OrdenCompra @relation(fields: [orden_id], references: [id_orden], onDelete: Cascade)

  @@index([tenant_id, orden_id])
  @@map("ordenes_compra_items")
}

model RecepcionOC {
  id_recepcion    String   @id @default(uuid()) @db.Uuid
  tenant_id       String   @db.Uuid
  proyecto_id     String   @db.Uuid
  orden_id        String   @db.Uuid
  fecha_recepcion DateTime @default(now())
  recibido_por    String   @db.Uuid
  notas           String?
  created_at      DateTime @default(now())

  orden  OrdenCompra       @relation(fields: [orden_id], references: [id_orden], onDelete: Cascade)
  items  RecepcionOCItem[]

  @@index([tenant_id, orden_id])
  @@map("recepciones_oc")
}

model RecepcionOCItem {
  id_recepcion_item String  @id @default(uuid()) @db.Uuid
  tenant_id         String  @db.Uuid
  proyecto_id       String  @db.Uuid
  recepcion_id      String  @db.Uuid
  orden_item_id     String  @db.Uuid
  cantidad_recibida Decimal @db.Decimal(18, 4)
  nota_discrepancia String?

  recepcion RecepcionOC @relation(fields: [recepcion_id], references: [id_recepcion], onDelete: Cascade)

  @@index([tenant_id, recepcion_id])
  @@map("recepcion_oc_items")
}

// --- Operativo: Cuadros Comparativos ---
// Estados: BORRADOR → EN_EVALUACION_TECNICA → LOCKED (firmado por Residente, INMUTABLE)
//        → EN_APROBACION_GT → APROBADO_GT → CERRADO
//        → RECHAZADO_GT (terminal) → SUPERSEDIDO (reemplazado por revisión posterior)
model CuadroComparativo {
  id_cuadro      String   @id @default(uuid()) @db.Uuid
  tenant_id      String   @db.Uuid
  proyecto_id    String   @db.Uuid
  requisicion_id String   @db.Uuid
  codigo         String   @db.VarChar(50) // Ej. CC-2026-001
  fecha_creacion DateTime @default(now())
  estado         String   @default("BORRADOR")
  notas          String?  @db.Text

  // ── Control de revisiones ────────────────────────────────────────────────
  revision              String  @default("A") @db.VarChar(5)
  revision_padre_id     String? @db.Uuid  // self-ref sin @relation

  // ── Firma digital (Residente) ────────────────────────────────────────────
  firmado_por           String?   @db.Uuid
  fecha_firma           DateTime?

  // ── Selección de proveedor preferido ────────────────────────────────────
  primera_opcion_proveedor_id  String? @db.Uuid
  segunda_opcion_proveedor_id  String? @db.Uuid

  // ── Veredicto técnico del Residente (antes de firma) ────────────────────
  /// Texto libre de veredicto general del Residente — obligatorio para firmar
  veredicto_residente   String? @db.Text
  /// UUIDs de proveedores recomendados — JSON array serializado
  proveedores_sugeridos String? @db.Text

  // ── Auditoría evaluación técnica (Residente) ─────────────────────────────
  evaluacion_residente_id  String?   @db.Uuid
  fecha_evaluacion_tecnica DateTime?

  // ── Auditoría aprobación GT ──────────────────────────────────────────────
  gerente_tecnico_id    String?   @db.Uuid
  fecha_aprobacion_gt   DateTime?
  comentario_gt_general String?   @db.Text

  detalles            ComparativaDetalle[]
  lineas              ComparativaLinea[]
  aclaraciones        AclaracionComparativa[]
  auditoria_desbloqueos AuditoriaDesbloqueoComparativa[]

  @@unique([tenant_id, codigo])
  @@index([tenant_id, proyecto_id])
  @@map("cuadros_comparativos")
}

// ── Auditoría de desbloqueos de cuadros firmados ─────────────────────────────
// Cada vez que un admin desbloquea un cuadro FIRMADO_BLOQUEADO queda un registro inmutable.
model AuditoriaDesbloqueoComparativa {
  id_auditoria         String   @id @default(uuid()) @db.Uuid
  tenant_id            String   @db.Uuid
  proyecto_id          String   @db.Uuid
  cuadro_id            String   @db.Uuid
  desbloqueado_por     String   @db.Uuid
  timestamp_desbloqueo DateTime @default(now())
  justificacion        String   @db.Text

  cuadro  CuadroComparativo @relation(fields: [cuadro_id], references: [id_cuadro], onDelete: Cascade)

  @@index([tenant_id, cuadro_id])
  @@map("auditoria_desbloqueo_comparativa")
}

// --- Detalles técnicos por partida (cuadro × insumo) ---
// Una fila por insumo en el cuadro — independiente de cuántos proveedores haya.
// Editable por Compras en estado BORRADOR; solo lectura después.
model ComparativaLinea {
  id_linea                  String   @id @default(uuid()) @db.Uuid
  tenant_id                 String   @db.Uuid
  proyecto_id               String   @db.Uuid
  cuadro_id                 String   @db.Uuid
  insumo_id                 String   @db.Uuid
  marca_modelo_ref          String?  @db.VarChar(100)
  especificaciones_requeridas String? @db.Text
  // Referencia al RequisicionItem de origen (nullable para cuadros anteriores)
  detalle_req_id            String?  @db.Uuid

  cuadro  CuadroComparativo @relation(fields: [cuadro_id], references: [id_cuadro], onDelete: Cascade)

  @@unique([cuadro_id, insumo_id])
  @@index([tenant_id, cuadro_id])
  @@map("comparativas_lineas")
}

model ComparativaDetalle {
  id_detalle     String   @id @default(uuid()) @db.Uuid
  tenant_id      String   @db.Uuid
  proyecto_id    String   @db.Uuid
  cuadro_id      String   @db.Uuid
  proveedor_id   String   @db.Uuid
  insumo_id      String   @db.Uuid
  precio_ofertado Decimal @db.Decimal(18, 4)
  tiempo_entrega String?  @db.VarChar(50)
  es_ganador     Boolean  @default(false)

  // ── Evaluación técnica del Residente ─────────────────────────────────────
  // Valores escritura nueva: PENDIENTE | C | NC | DA | ?
  // Valores legacy (solo lectura): APROBADO | RECHAZADO
  evaluacion_tecnica   String  @default("PENDIENTE")
  comentario_tecnico   String? @db.Text
  valor_ofrecido_spec  String? @db.Text  // Lo que el proveedor ofrece (texto libre de Compras)

  // ── Pregunta del Residente (cuando marca "?") y respuesta de Compras ────────
  /// Pregunta del Residente cuando marcó "?" — dispara nueva revisión del cuadro
  pregunta_residente String? @db.Text
  /// Respuesta de Compras a la pregunta del Residente — visible en la revisión siguiente
  respuesta_compras  String? @db.Text

  // ── Aprobación del Gerente Técnico ────────────────────────────────────────
  // Valores: PENDIENTE | APROBADO | RECHAZADO
  // Regla: no puede ser APROBADO si evaluacion_tecnica = RECHAZADO
  aprobacion_gt String  @default("PENDIENTE")
  comentario_gt String? @db.Text

  cuadro         CuadroComparativo @relation(fields: [cuadro_id], references: [id_cuadro], onDelete: Cascade)
  proveedor      Proveedor         @relation(fields: [proveedor_id], references: [id_proveedor])

  @@index([tenant_id, cuadro_id])
  @@map("comparativas_detalles")
}

// ── Aclaraciones técnicas por celda (cuadro × insumo × proveedor) ────────────
// Tipos: PREGUNTA (Residente no puede decidir → solicita info a Compras)
//        RESPUESTA (Compras transcribe respuesta del proveedor)
model AclaracionComparativa {
  id_aclaracion String   @id @default(uuid()) @db.Uuid
  tenant_id     String   @db.Uuid
  proyecto_id   String   @db.Uuid
  cuadro_id     String   @db.Uuid
  insumo_id     String   @db.Uuid
  proveedor_id  String   @db.Uuid
  autor_id      String   @db.Uuid
  tipo          String   @db.VarChar(20)  // PREGUNTA | RESPUESTA
  mensaje       String   @db.Text
  resuelta      Boolean  @default(false)
  created_at    DateTime @default(now())

  cuadro  CuadroComparativo @relation(fields: [cuadro_id], references: [id_cuadro], onDelete: Cascade)

  @@index([tenant_id, cuadro_id])
  @@index([cuadro_id, insumo_id, proveedor_id])
  @@map("aclaraciones_comparativa")
}

// ── Especificaciones técnicas por partida de requisición ─────────────────────
// N especificaciones por RequisicionItem — el Residente las captura al crear/editar la req.
model EspecificacionDetalleReq {
  id_especificacion String   @id @default(uuid()) @db.Uuid
  tenant_id         String   @db.Uuid
  proyecto_id       String   @db.Uuid
  detalle_id        String   @db.Uuid   // ref a RequisicionItem.id_item (misma BD)
  descripcion       String   @db.Text
  orden             Int      @default(0)
  created_at        DateTime @default(now())

  @@index([tenant_id, detalle_id])
  @@map("especificaciones_detalle_req")
}

// ── Solicitudes de Cotización ─────────────────────────────────────────────────
// Una solicitud por requisición (única activa). Registra a qué proveedores se les pidió cotizar y el plazo.
model SolicitudCotizacion {
  id_solicitud    String   @id @default(uuid()) @db.Uuid
  tenant_id       String   @db.Uuid
  proyecto_id     String   @db.Uuid
  requisicion_id  String   @db.Uuid
  dias_habiles    Int      @default(3)
  fecha_solicitud DateTime @default(now())
  fecha_limite    DateTime
  creado_por      String   @db.Uuid
  notas           String?  @db.Text
  created_at      DateTime @default(now())

  proveedores SolicitudCotizacionProveedor[]

  @@unique([tenant_id, requisicion_id])
  @@index([tenant_id, proyecto_id])
  @@map("solicitudes_cotizacion")
}

model SolicitudCotizacionProveedor {
  id_scp          String    @id @default(uuid()) @db.Uuid
  tenant_id       String    @db.Uuid
  solicitud_id    String    @db.Uuid
  proveedor_id    String    @db.Uuid
  estado          String    @default("PENDIENTE")  // PENDIENTE | RESPONDIO | DECLINO
  pdf_nombre      String?   @db.VarChar(255)
  pdf_ruta        String?   @db.Text
  pdf_mime        String?   @db.VarChar(100)
  notas_proveedor String?   @db.Text
  fecha_respuesta DateTime?
  updated_at      DateTime  @updatedAt

  solicitud SolicitudCotizacion @relation(fields: [solicitud_id], references: [id_solicitud], onDelete: Cascade)

  @@unique([solicitud_id, proveedor_id])
  @@index([tenant_id, solicitud_id])
  @@map("solicitudes_cotizacion_proveedores")
}

// ── Anotaciones por celda [especificación × proveedor] en el cuadro comparativo ──
// El Residente puede plantear preguntas puntuales sobre una especificación de un proveedor;
// Compras registra la respuesta. Independiente del flujo C/NC/DA/?.
model AnotacionEspecificacion {
  id_anotacion      String   @id @default(uuid()) @db.Uuid
  tenant_id         String   @db.Uuid
  cuadro_id         String   @db.Uuid
  especificacion_id String   @db.Uuid  // ref a EspecificacionDetalleReq
  proveedor_id      String   @db.Uuid
  tipo              String   @db.VarChar(20)  // pregunta | respuesta
  texto             String   @db.Text
  creado_por        String   @db.Uuid
  created_at        DateTime @default(now())

  @@index([tenant_id, cuadro_id])
  @@index([tenant_id, especificacion_id])
  @@map("anotaciones_especificacion")
}

// ── Alertas de Integridad Financiera ─────────────────────────────────────────
// Persiste OCs que entraron en ERROR_FINANZAS para que el equipo de procuración
// pueda detectar inconsistencias sin depender del EventBus (best-effort).

model AlertaOcError {
  id             String   @id @default(uuid()) @db.Uuid
  tenant_id      String   @db.Uuid
  proyecto_id    String   @db.Uuid
  oc_id          String   @db.Uuid
  oc_codigo      String   @db.VarChar(50)
  presupuesto_id String?  @db.Uuid
  error_message  String   @db.Text
  resuelta       Boolean  @default(false)
  created_at     DateTime @default(now())
  updated_at     DateTime @updatedAt

  @@unique([tenant_id, oc_id])
  @@index([tenant_id, proyecto_id])
  @@map("alertas_oc_error")
}

// ── Almacén → microservicio independiente apps/almacen (puerto 3012) ──────────
// Los modelos ItemInventario y MovimientoAlmacen fueron migrados.
// BD: ALMACEN_DATABASE_URL — Migración: docker compose exec almacen npx prisma migrate deploy
