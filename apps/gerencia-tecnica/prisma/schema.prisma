// ---------------------------------------------------------------------------
// Propiedad Intelectual: Constructora Bocam, S. A. de C.V.
// Clasificación: Estrictamente Confidencial.
// Módulo: Gerencia Técnica (Ingeniería y Presupuestos)
// Responsabilidad: Catálogo Maestro de Insumos y Presupuesto Base.
// ---------------------------------------------------------------------------

generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
  // clientExtensions ya es GA en Prisma 5+, no se requiere previewFeatures.
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ======================================================================
// ENTIDADES MAESTRAS (DUEÑO: Gerencia Técnica)
// ======================================================================

/// Catálogo de categorías de gasto por proyecto — gestionadas por Control de Proyectos.
/// Predefinidas por el sistema (seed); personalizables por tenant antes de activar el proyecto.
/// Congeladas una vez que el proyecto pasa a estado ACTIVO.
model CategoriaGasto {
  id_categoria String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenant_id    String   @db.Uuid
  proyecto_id  String   @db.Uuid
  nombre       String   @db.VarChar(100)
  es_predefinida Boolean @default(false)
  activa       Boolean  @default(true)
  created_at   DateTime @default(now()) @db.Timestamptz(6)

  insumos      Insumo[]

  @@index([tenant_id, proyecto_id], name: "idx_categoria_gasto_tenant_proyecto")
  @@map("categorias_gasto")
}

/// Configuración de control de costos por proyecto.
/// Almacena el estado CONFIGURACION/ACTIVO/CERRADO para congelar categorías.
model ProyectoCostosConfig {
  id           String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenant_id    String    @db.Uuid
  proyecto_id  String    @db.Uuid
  estado       String    @default("CONFIGURACION") @db.VarChar(20)
  activado_por String?   @db.Uuid
  fecha_activacion DateTime?
  created_at   DateTime  @default(now()) @db.Timestamptz(6)
  updated_at   DateTime  @updatedAt @db.Timestamptz(6)

  @@unique([tenant_id, proyecto_id], name: "uq_proyecto_costos_config")
  @@index([tenant_id], name: "idx_proyecto_costos_config_tenant")
  @@map("proyecto_costos_config")
}

/// Catálogo Maestro de Insumos: Materiales, Mano de Obra, Equipo, Subcontratos.
/// Tabla maestra con aislamiento por tenant_id (RLS).
model Insumo {
  id                 String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenant_id          String          @db.Uuid
  /// NULL = insumo legacy sin proyecto atribuible (ver aislamiento-insumos-por-proyecto-gt, Decision 1/3)
  proyecto_id        String?         @db.Uuid

  clave              String          @db.VarChar(50)
  descripcion        String          @db.Text
  unidad_medida      String          @db.VarChar(20)
  tipo_insumo        TipoInsumo
  costo_base         Decimal         @db.Decimal(12, 4)

  /// Categoría de gasto asignada por Control de Proyectos (nullable hasta clasificar)
  categoria_gasto_id String?         @db.Uuid
  categoria_gasto    CategoriaGasto? @relation(fields: [categoria_gasto_id], references: [id_categoria])

  activo        Boolean    @default(true)
  created_at    DateTime   @default(now()) @db.Timestamptz(6)
  updated_at    DateTime   @updatedAt @db.Timestamptz(6)

  // Composiciones APU que usan este insumo
  concepto_insumos ConceptoInsumo[]

  // Índices de rendimiento Multi-Tenant
  @@unique([tenant_id, proyecto_id, clave], name: "uq_insumo_tenant_proyecto_clave")
  @@index([tenant_id], name: "idx_insumo_tenant")
  @@index([tenant_id, proyecto_id], name: "idx_insumo_tenant_proyecto")
  @@index([tenant_id, categoria_gasto_id], name: "idx_insumo_categoria")
  @@map("insumos")
}

/// Presupuesto Base de un proyecto/centro de costos.
/// Tabla transaccional: requiere OBLIGATORIAMENTE tenant_id + proyecto_id.
model PresupuestoBase {
  id               String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenant_id        String            @db.Uuid
  proyecto_id      String            @db.Uuid

  version          Int               @default(1)
  estado           EstadoPresupuesto @default(BORRADOR)
  importe_total    Decimal           @default(0.00) @db.Decimal(15, 2)

  aprobado_por     String?           @db.Uuid
  fecha_aprobacion DateTime?

  conceptos        Concepto[]
  capitulos        Capitulo[]

  created_at       DateTime          @default(now()) @db.Timestamptz(6)
  updated_at       DateTime          @updatedAt @db.Timestamptz(6)

  // Índices de rendimiento Multi-Tenant + Multi-Proyecto
  @@index([tenant_id, proyecto_id], name: "idx_presupuesto_tenant_proyecto")
  @@index([tenant_id], name: "idx_presupuesto_tenant")
  @@map("presupuestos_base")
}

/// Capítulo de un presupuesto: agrupación jerárquica de conceptos (WBS, tipo OPUS).
/// Alcance por presupuesto (no por tenant como ConceptoCatalogo): la estructura de
/// capítulos de una obra puede variar legítimamente entre obras del mismo tenant.
/// Ver openspec/changes/wbs-jerarquico-conceptos/design.md Decision 1.
model Capitulo {
  id              String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenant_id       String          @db.Uuid
  proyecto_id     String          @db.Uuid
  presupuesto_id  String          @db.Uuid
  presupuesto     PresupuestoBase @relation(fields: [presupuesto_id], references: [id], onDelete: Cascade)

  clave           String          @db.VarChar(50)
  nombre          String          @db.VarChar(255)
  orden           Int             @default(0)

  conceptos       Concepto[]

  created_at      DateTime        @default(now()) @db.Timestamptz(6)
  updated_at      DateTime        @updatedAt @db.Timestamptz(6)

  @@unique([presupuesto_id, clave], name: "uq_capitulo_presupuesto_clave")
  @@index([tenant_id, proyecto_id], name: "idx_capitulo_tenant_proyecto")
  @@index([tenant_id, presupuesto_id], name: "idx_capitulo_tenant_presupuesto")
  @@map("capitulos")
}

/// Catálogo Maestro de Conceptos: reutilizable entre proyectos del mismo tenant.
/// Mismo patrón que Insumo (único por tenant_id + clave). Solo referencia
/// descripcion/unidad_medida para detectar divergencias al importar — NUNCA
/// guarda precio_unitario ni cantidad (esos siempre vienen del presupuesto real).
/// Ver design.md Decision 5.
model ConceptoCatalogo {
  id            String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenant_id     String   @db.Uuid

  clave         String   @db.VarChar(50)
  descripcion   String   @db.Text
  unidad_medida String   @db.VarChar(20)

  created_at    DateTime @default(now()) @db.Timestamptz(6)
  updated_at    DateTime @updatedAt @db.Timestamptz(6)

  @@unique([tenant_id, clave], name: "uq_concepto_catalogo_tenant_clave")
  @@index([tenant_id], name: "idx_concepto_catalogo_tenant")
  @@map("conceptos_catalogo")
}

/// Concepto de Obra: Línea o partida específica de un presupuesto.
/// Tabla transaccional hija, hereda tenant_id y proyecto_id del padre.
model Concepto {
  id              String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenant_id       String          @db.Uuid
  proyecto_id     String          @db.Uuid
  presupuesto_id  String          @db.Uuid
  presupuesto     PresupuestoBase @relation(fields: [presupuesto_id], references: [id], onDelete: Cascade)

  /// Capítulo al que pertenece este concepto (WBS). Nullable: los conceptos
  /// históricos y los importados sin columna de capítulo quedan sin agrupar.
  capitulo_id     String?         @db.Uuid
  capitulo        Capitulo?       @relation(fields: [capitulo_id], references: [id])

  clave           String          @db.VarChar(50)
  descripcion     String          @db.Text
  unidad_medida   String          @db.VarChar(20)
  cantidad        Decimal         @db.Decimal(12, 4)
  precio_unitario Decimal         @db.Decimal(12, 4)
  importe         Decimal         @db.Decimal(15, 2)

  created_at      DateTime        @default(now()) @db.Timestamptz(6)
  updated_at      DateTime        @updatedAt @db.Timestamptz(6)

  // Composición APU: insumos que componen este concepto
  insumos         ConceptoInsumo[]

  // Índices de rendimiento Multi-Tenant + Multi-Proyecto
  // Unicidad por versión de presupuesto (no por proyecto completo): un proyecto
  // tiene varias versiones de PresupuestoBase a lo largo del tiempo que
  // reutilizan legítimamente las mismas claves. Ver design.md Decision 2.
  @@unique([tenant_id, proyecto_id, presupuesto_id, clave], name: "uq_concepto_tenant_proyecto_presupuesto_clave")
  @@index([tenant_id, proyecto_id], name: "idx_concepto_tenant_proyecto")
  @@index([tenant_id, presupuesto_id], name: "idx_concepto_tenant_presupuesto")
  @@index([tenant_id, capitulo_id], name: "idx_concepto_tenant_capitulo")
  @@map("conceptos")
}

/// Composición APU: relación entre un Concepto y sus Insumos (rendimientos y cantidades).
/// Se pobla al importar el archivo "ANÁLISIS DE PRECIOS UNITARIOS" de OPUS.
/// Permite calcular take-off de materiales a partir del avance reportado.
model ConceptoInsumo {
  id             String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenant_id      String     @db.Uuid
  proyecto_id    String     @db.Uuid

  concepto_id    String     @db.Uuid
  concepto       Concepto   @relation(fields: [concepto_id], references: [id], onDelete: Cascade)
  insumo_id      String     @db.Uuid
  insumo         Insumo     @relation(fields: [insumo_id], references: [id])

  tipo_insumo    TipoInsumo
  /// Cantidad del insumo por unidad de concepto (ej. 0.15 M3 de oxígeno por M3 excavado)
  cantidad       Decimal    @db.Decimal(12, 4)
  /// Rendimiento: unidades de producción por jornada/hora (OPUS: col "Rendimiento")
  rendimiento    Decimal    @default(0) @db.Decimal(12, 4)
  /// Costo unitario del insumo al momento de importación del APU
  costo_unitario Decimal    @default(0) @db.Decimal(12, 4)

  created_at     DateTime   @default(now()) @db.Timestamptz(6)
  updated_at     DateTime   @updatedAt @db.Timestamptz(6)

  @@unique([concepto_id, insumo_id], name: "uq_concepto_insumo")
  @@index([tenant_id, proyecto_id], name: "idx_ci_tenant_proyecto")
  @@index([tenant_id, concepto_id], name: "idx_ci_concepto")
  @@map("concepto_insumos")
}

// ======================================================================
// CONTROL PRESUPUESTAL POR PARTIDA
// ======================================================================

/// Saldo presupuestal por concepto/partida del catálogo APU.
/// Se crea automáticamente al aprobar un presupuesto (uno por concepto).
/// Es el gate de control antes de generar OC o aprobar requisiciones.
model SaldoPartida {
  id              String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenant_id       String   @db.Uuid
  proyecto_id     String   @db.Uuid
  concepto_id     String   @db.Uuid
  concepto_clave  String   @db.VarChar(50)
  concepto_desc   String   @db.Text
  /// Tipo de insumo con mayor costo acumulado en el APU del concepto (MATERIAL, MANO_DE_OBRA,
  /// EQUIPO, SUBCONTRATO, INDIRECTO), o null si el concepto no tiene composición APU.
  /// Se usa para clasificar el presupuesto sincronizado en Finanzas por capítulo.
  categoria_predominante String? @db.VarChar(20)

  monto_aprobado     Decimal @default(0) @db.Decimal(18, 2)
  monto_comprometido Decimal @default(0) @db.Decimal(18, 2)
  monto_ejercido     Decimal @default(0) @db.Decimal(18, 2)
  monto_en_proceso   Decimal @default(0) @db.Decimal(18, 2)
  monto_disponible   Decimal @default(0) @db.Decimal(18, 2)

  estado_tope       String  @default("LIBRE") @db.VarChar(20)
  bloqueo_automatico Boolean @default(true)

  created_at DateTime @default(now()) @db.Timestamptz(6)
  updated_at DateTime @updatedAt @db.Timestamptz(6)

  movimientos SaldoMovimiento[]

  @@unique([tenant_id, proyecto_id, concepto_id], name: "uq_saldo_partida")
  @@index([tenant_id, proyecto_id], name: "idx_saldo_partida_proyecto")
  @@map("saldo_partidas")
}

/// Audit trail de cada cambio en SaldoPartida (compromisos, pagos, reversas).
model SaldoMovimiento {
  id              String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenant_id       String   @db.Uuid
  saldo_partida_id String  @db.Uuid
  saldo_partida   SaldoPartida @relation(fields: [saldo_partida_id], references: [id], onDelete: Cascade)

  referencia_id   String   @db.Uuid
  referencia_codigo String? @db.VarChar(100)
  tipo            String   @db.VarChar(30)
  campo           String   @db.VarChar(30)
  delta           Decimal  @db.Decimal(18, 2)
  saldo_resultante Decimal @db.Decimal(18, 2)

  created_at DateTime @default(now()) @db.Timestamptz(6)

  @@unique([saldo_partida_id, referencia_id, tipo], name: "uq_saldo_movimiento_idem")
  @@index([tenant_id, saldo_partida_id], name: "idx_saldo_mov_partida")
  @@map("saldo_movimientos")
}

// ======================================================================
// ENUMERACIONES
// ======================================================================

enum TipoInsumo {
  MATERIAL
  MANO_DE_OBRA
  EQUIPO
  SUBCONTRATO
  INDIRECTO
}

enum EstadoPresupuesto {
  BORRADOR
  EN_REVISION
  APROBADO
  LIBERADO     // Emite evento: PresupuestoBaseLiberado
  CONGELADO
}

// ======================================================================
// TRANSFERENCIAS ENTRE PARTIDAS
// ======================================================================

/// Solicitud formal de mover presupuesto de una partida a otra.
/// Requiere aprobación del director antes de ajustar SaldoPartida.
model TransferenciaPartida {
  id                     String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenant_id              String   @db.Uuid
  tipo                   String   @default("INTERNA") @db.VarChar(20)

  proyecto_origen_id     String   @db.Uuid
  concepto_origen_id     String?  @db.Uuid
  concepto_origen_clave  String   @db.VarChar(100)
  concepto_origen_desc   String   @db.Text

  proyecto_destino_id    String   @db.Uuid
  concepto_destino_id    String   @db.Uuid
  concepto_destino_clave String   @db.VarChar(100)
  concepto_destino_desc  String   @db.Text

  monto                  Decimal  @db.Decimal(18, 2)
  moneda                 String   @default("MXN") @db.VarChar(3)

  justificacion          String   @db.Text
  solicitado_por_id      String   @db.Uuid
  solicitado_por_nombre  String   @db.VarChar(200)

  aprobado_por_id        String?  @db.Uuid
  aprobado_por_nombre    String?  @db.VarChar(200)
  fecha_aprobacion       DateTime? @db.Timestamptz(6)

  estado                 String   @default("PENDIENTE") @db.VarChar(20)
  motivo_rechazo         String?  @db.Text
  notas_director         String?  @db.Text

  created_at             DateTime @default(now()) @db.Timestamptz(6)
  updated_at             DateTime @updatedAt @db.Timestamptz(6)

  @@index([tenant_id, proyecto_origen_id], name: "idx_transferencia_origen")
  @@index([tenant_id, proyecto_destino_id], name: "idx_transferencia_destino")
  @@index([tenant_id, estado], name: "idx_transferencia_estado")
  @@map("transferencia_partidas")
}

// ======================================================================
// PROYECCIÓN DE COMPRAS (desde eventos Compras → GT para trazabilidad)
// ======================================================================

/// Espejo de OC creadas/canceladas proyectado en GT via eventos.
/// Permite calcular "comprado" por concepto sin llamar a Compras en tiempo real.
model CompraProyectada {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenant_id   String   @db.Uuid
  proyecto_id String   @db.Uuid
  concepto_id String   @db.Uuid
  insumo_id   String   @db.Uuid
  oc_id       String   @db.Uuid
  oc_codigo   String   @db.VarChar(50)
  cantidad    Decimal  @db.Decimal(18, 4)
  monto       Decimal  @db.Decimal(18, 2)
  estado      String   @default("VIGENTE") @db.VarChar(20)
  created_at  DateTime @default(now()) @db.Timestamptz(6)

  @@unique([oc_id, insumo_id], name: "uq_compra_proyectada_oc_insumo")
  @@index([tenant_id, proyecto_id, concepto_id], name: "idx_compra_proyectada_concepto")
  @@map("compras_proyectadas")
}

// ======================================================================
// FICHAS TÉCNICAS DE INSUMO
// Documentos (PDF, Word, imágenes) que los proveedores envían como
// especificación del material/equipo. Vinculados al insumo del catálogo.
// ======================================================================

model FichaTecnicaInsumo {
  id_ficha     String   @id @default(uuid()) @db.Uuid
  tenant_id    String   @db.Uuid
  insumo_id    String   @db.Uuid
  proveedor_ref String? @db.VarChar(100)
  nombre_doc   String   @db.VarChar(255)
  ruta_archivo String   @db.Text
  mime_type    String   @db.VarChar(100)
  tamano_bytes Int
  subido_por   String   @db.Uuid
  created_at   DateTime @default(now())

  @@index([tenant_id, insumo_id])
  @@map("fichas_tecnicas_insumo")
}

model ProyectoObraVinculado {
  id             String   @id @default(uuid()) @db.Uuid
  tenant_id      String   @db.Uuid
  proyecto_id    String   @db.Uuid
  cotizacion_id  String   @db.Uuid
  monto_contrato Decimal  @db.Decimal(18, 2)
  moneda         String   @default("MXN") @db.VarChar(3)
  cliente_nombre String   @db.VarChar(255)
  fecha_contrato DateTime @db.Date
  estado         String   @default("SIN_PRESUPUESTO") @db.VarChar(30)
  notas          String?  @db.VarChar(500)
  created_at     DateTime @default(now()) @db.Timestamptz(6)
  updated_at     DateTime @updatedAt @db.Timestamptz(6)

  @@unique([tenant_id, cotizacion_id])
  @@index([tenant_id, proyecto_id])
  @@map("proyectos_obra_vinculados")
}

