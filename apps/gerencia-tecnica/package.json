{
  "name": "@bocam/gerencia-tecnica",
  "version": "1.0.0",
  "description": "Módulo de Gerencia Técnica (Insumos y Presupuestos)",
  "main": "dist/main.js",
  "scripts": {
    "build": "tsc",
    "dev": "ts-node-dev src/main.ts",
    "prisma:generate": "prisma generate --schema prisma/schema.prisma",
    "prisma:migrate": "prisma migrate dev --schema prisma/schema.prisma",
    "test:integration": "node -r ts-node/register/transpile-only test/integration/saldo-partida.integration.test.ts",
    "test:integration:fichas-tecnicas-residente": "node -r ts-node/register/transpile-only test/integration/fichas-tecnicas-residente.integration.test.ts",
    "test:integration:presupuesto-activo-precio-cantidad": "node -r ts-node/register/transpile-only test/integration/presupuesto-activo-precio-cantidad.integration.test.ts",
    "test:integration:presupuestos-unicidad-clave": "node -r ts-node/register/transpile-only test/integration/presupuestos-unicidad-clave.integration.test.ts",
    "test:integration:presupuestos-catalogo-maestro": "node -r ts-node/register/transpile-only test/integration/presupuestos-catalogo-maestro.integration.test.ts",
    "test:integration:presupuestos-capitulos": "node -r ts-node/register/transpile-only test/integration/presupuestos-capitulos.integration.test.ts",
    "test:integration:validacion-longitud-insumo": "node -r ts-node/register/transpile-only test/integration/validacion-longitud-insumo.integration.test.ts"
  },
  "dependencies": {
    "@bocam/rate-limiter": "^1.0.0",
    "@prisma/client": "^5.0.0",
    "amqplib": "^0.10.3",
    "express": "^4.18.2",
    "multer": "^2.1.1",
    "redis": "^4.6.7",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/amqplib": "^0.10.1",
    "@types/express": "^4.17.17",
    "@types/multer": "^2.2.0",
    "@types/node": "^20.0.0",
    "@types/uuid": "^9.0.2",
    "prisma": "^5.0.0",
    "ts-node": "^10.9.1",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.1.3",
    "uuid": "^14.0.0"
  },
  "prisma": {
    "seed": "ts-node prisma/seed.ts"
  }
}
